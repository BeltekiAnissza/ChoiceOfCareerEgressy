@page
@model ChoiceOfCareerEgressy.Pages.Student.IndexModel

@{
    ViewData["Title"] = "Programválasztás";
}

<div class="container mt-4">

    <h2>Pályaorientációs programválasztás</h2>

    <p class="text-muted">
        Válassz olyan programokat, amelyek együtt lefedik
        a pályaorientációs nap időszakait!
        Egy hosszabb program több idősávot is teljesíthet.
    </p>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success">
            @Model.SuccessMessage
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger">
            @Model.ErrorMessage
        </div>
    }

    @if (!Model.Events.Any())
    {
        <div class="alert alert-info">
            Jelenleg nincs elérhető esemény.
        </div>
    }

    @foreach (var ev in Model.Events)
    {
        <div class="card shadow-sm mb-4">

            <div class="card-header">
                <h4 class="mb-1">@ev.EventName</h4>

                <small>
                    @ev.EventDate.ToString("yyyy.MM.dd.")
                </small>
            </div>

            <div class="card-body">

                <p>
                    Jelentkezési időszak:
                    <strong>
                        @ev.RegistrationStart.ToString("yyyy.MM.dd. HH:mm")
                        –
                        @ev.RegistrationEnd.ToString("yyyy.MM.dd. HH:mm")
                    </strong>
                </p>

                @if (ev.HasRegistration)
                {
                    <div class="alert alert-success">
                        Már van rögzített jelentkezésed erre az eseményre.
                    </div>
                }

                @if (ev.CanRegister)
                {
                    <form method="post"
                          class="student-registration-form"
                          asp-page-handler="@(ev.HasRegistration ? "Update" : null)">

                        <input type="hidden"
                               name="Registration.EventId"
                               value="@ev.EventId" />

                        @foreach (var slot in ev.TimeSlots)
                        {
                            <div class="mb-4">

                                <h5 class="border-bottom pb-2">
                                    @slot.TimeSlotName
                                    <small class="text-muted">
                                        (@slot.BeginDate.ToString("HH:mm")
                                        –
                                        @slot.EndDate.ToString("HH:mm"))
                                    </small>
                                </h5>

                                @if (!slot.Programs.Any())
                                {
                                    <p class="text-muted">
                                        Ebben az idősávban nincs számodra
                                        elérhető program.
                                    </p>
                                }

                                @foreach (var program in slot.Programs)
                                {
                                    bool isFull =
                                    program.AvailablePlaces <= 0;

                                    <div class="border rounded p-3 mt-2">

                                        <div class="form-check">

                                            <input type="checkbox"
                                                   class="form-check-input student-program-checkbox"
                                                   name="Registration.SelectedPlanSessionIds"
                                                   value="@program.PlanSessionId"
                                                   id="program-@ev.EventId-@program.PlanSessionId"
                                                   data-program-name="@program.PlanName"
                                                   data-start="@program.BeginDate.ToUnixTimeMilliseconds()"
                                                   data-end="@program.EndDate.ToUnixTimeMilliseconds()"
                                                   checked="@program.IsSelected"
                                                   disabled="@(isFull && !program.IsSelected)" />

                                            <label class="form-check-label"
                                                   for="program-@ev.EventId-@program.PlanSessionId">

                                                <strong>@program.PlanName</strong>

                                            </label>

                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(
                                                                program.Description))
                                        {
                                            <p class="mb-1 mt-2">
                                                @program.Description
                                            </p>
                                        }

                                        <small class="text-muted">
                                            Időpont:
                                            @program.BeginDate.ToString("HH:mm")
                                            –
                                            @program.EndDate.ToString("HH:mm")
                                            |
                                            Terem: @program.LocationName
                                            |
                                            Kapacitás: @program.Capacity
                                            |
                                            Szabad hely: @program.AvailablePlaces
                                        </small>

                                        @if (isFull)
                                        {
                                            <div class="mt-2">
                                                @if (program.IsSelected)
                                                {
                                                    <span class="badge bg-success">
                                                        Saját foglalásod
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger">
                                                        Betelt
                                                    </span>
                                                }
                                            </div>
                                        }

                                    </div>
                                }

                            </div>
                        }

                        <div class="alert alert-info">
                            A kiválasztott programok nem ütközhetnek
                            időben, és együtt le kell fedniük
                            az esemény összes idősávját.
                        </div>

                        <div class="student-selection-summary mb-3">
                        </div>

                        @if (ev.HasRegistration)
                        {
                            <button type="submit"
                                    class="btn btn-primary">
                                Módosítások mentése
                            </button>
                        }
                        else
                        {
                            <button type="submit"
                                    class="btn btn-success">
                                Jelentkezés mentése
                            </button>
                        }

                    </form>
                }
                else if (ev.HasRegistration)
                {
                    <div class="alert alert-secondary">
                        A jelentkezés jelenleg nem módosítható.
                    </div>

                    @foreach (var slot in ev.TimeSlots)
                    {
                        var selectedPrograms = slot.Programs
                        .Where(p => p.IsSelected)
                        .ToList();

                        @foreach (var program in selectedPrograms)
                        {
                            <div class="mb-3">
                                <strong>@program.PlanName</strong>
                                – @program.LocationName
                                <span class="text-muted">
                                    (@program.BeginDate.ToString("HH:mm")
                                    –
                                    @program.EndDate.ToString("HH:mm"))
                                </span>
                            </div>
                        }
                    }
                }
                else
                {
                    <div class="alert alert-secondary">
                        A jelentkezés jelenleg nem elérhető.
                    </div>
                }

            </div>
        </div>
    }

</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const forms = document.querySelectorAll(
                ".student-registration-form"
            );

            forms.forEach(form => {

                const checkboxes = Array.from(
                    form.querySelectorAll(
                        ".student-program-checkbox"
                    )
                );

                const summary = form.querySelector(
                    ".student-selection-summary"
                );

                function selectedPrograms() {
                    return checkboxes.filter(c => c.checked);
                }

                function overlaps(first, second) {
                    const firstStart = Number(first.dataset.start);
                    const firstEnd = Number(first.dataset.end);
                    const secondStart = Number(second.dataset.start);
                    const secondEnd = Number(second.dataset.end);

                    return firstStart < secondEnd &&
                           secondStart < firstEnd;
                }

                function updateSummary() {
                    const selected = selectedPrograms();

                    if (selected.length === 0) {
                        summary.textContent =
                            "Még nem választottál programot.";
                        return;
                    }

                    summary.textContent =
                        "Kiválasztott programok: " +
                        selected.map(c => c.dataset.programName)
                            .join(", ");
                }

                checkboxes.forEach(checkbox => {

                    checkbox.addEventListener("change", function () {

                        if (checkbox.checked) {

                            const selected = selectedPrograms()
                                .filter(c => c !== checkbox);

                            const duplicate = selected.some(c =>
                                c.dataset.programName
                                    .trim()
                                    .toLocaleLowerCase("hu-HU") ===
                                checkbox.dataset.programName
                                    .trim()
                                    .toLocaleLowerCase("hu-HU")
                            );

                            const conflict = selected.some(c =>
                                overlaps(c, checkbox)
                            );

                            if (duplicate || conflict) {
                                checkbox.checked = false;

                                alert(duplicate
                                    ? "Ugyanazt a programot csak egyszer választhatod."
                                    : "Ez a program időben ütközik egy már kiválasztott programmal.");

                                updateSummary();
                                return;
                            }
                        }

                        updateSummary();
                    });
                });

                form.addEventListener("submit", function (event) {

                    if (selectedPrograms().length === 0) {
                        event.preventDefault();
                        alert("Válassz legalább egy programot!");
                    }
                });

                updateSummary();
            });
        });
    </script>
}
