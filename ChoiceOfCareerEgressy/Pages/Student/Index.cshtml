@page
@model ChoiceOfCareerEgressy.Pages.Student.IndexModel

@{
    ViewData["Title"] = "Programválasztás";
}

<div class="container mt-4">

    <h2>Pályaorientációs programválasztás</h2>

    <p class="text-muted">
        Válassz olyan programokat, amelyek együtt lefedik
        a pályaorientációs nap időszakait!
        Egy hosszabb program több idősávot is teljesíthet.
    </p>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success">
            @Model.SuccessMessage
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger">
            @Model.ErrorMessage
        </div>
    }

    @if (!Model.Events.Any())
    {
        <div class="alert alert-info">
            Jelenleg nincs elérhető esemény.
        </div>
    }

    @foreach (var ev in Model.Events)
    {
        <div class="card shadow-sm mb-4">

            <div class="card-header">
                <h4 class="mb-1">@ev.EventName</h4>

                <small>
                    @ev.EventDate.ToString("yyyy.MM.dd.")
                </small>
            </div>

            <div class="card-body">

                <p>
                    Jelentkezési időszak:
                    <strong>
                        @ev.RegistrationStart.ToString("yyyy.MM.dd. HH:mm")
                        –
                        @ev.RegistrationEnd.ToString("yyyy.MM.dd. HH:mm")
                    </strong>
                </p>

                @if (ev.HasRegistration)
                {
                    <div class="alert alert-success">
                        Már van rögzített jelentkezésed erre az eseményre.
                    </div>
                }

                @if (ev.CanRegister)
                {
                    <form method="post"
                          class="student-registration-form"
                          asp-page-handler="@(ev.HasRegistration ? "Update" : null)">

                        <input type="hidden"
                               name="Registration.EventId"
                               value="@ev.EventId" />

                        <!--
                            A kiválasztott programazonosítókat
                            JavaScript helyezi el itt
                            a mentés előtt.
                        -->
                        <div class="student-selected-inputs"></div>

                        <div class="accordion mb-4" id="studentSlots-@ev.EventId">

                            @foreach (var slot in ev.TimeSlots)
                            {
                                <div class="accordion-item mb-3">

                                    <h2 class="accordion-header"
                                        id="slotHeading-@ev.EventId-@slot.TimeSlotId">

                                        <button class="accordion-button"
                                                type="button"
                                                data-bs-toggle="collapse"
                                                data-bs-target="#slotContent-@ev.EventId-@slot.TimeSlotId"
                                                aria-expanded="true"
                                                aria-controls="slotContent-@ev.EventId-@slot.TimeSlotId">

                                            <span>
                                                <strong>@slot.TimeSlotName</strong>

                                                <small class="d-block mt-1">
                                                    @slot.BeginDate.ToString("HH:mm")
                                                    –
                                                    @slot.EndDate.ToString("HH:mm")
                                                </small>
                                            </span>

                                        </button>

                                    </h2>

                                    <div id="slotContent-@ev.EventId-@slot.TimeSlotId"
                                         class="accordion-collapse collapse show"
                                         aria-labelledby="slotHeading-@ev.EventId-@slot.TimeSlotId">

                                        <div class="accordion-body">

                                            @if (!slot.Programs.Any())
                                            {
                                                <p class="text-muted">
                                                    Ebben az idősávban nincs számodra
                                                    elérhető program.
                                                </p>
                                            }

                                            @foreach (var program in slot.Programs)
                                            {
                                                bool isFull = program.AvailablePlaces <= 0;

                                                <label for="program-@ev.EventId-@program.PlanSessionId"
                                                       class="border rounded p-3 mt-2 student-program-card d-block"
                                                       style="cursor: @(isFull && !program.IsSelected ? "not-allowed" : "pointer");">

                                                    <div class="form-check">

                                                        <input type="radio"
                                                               class="form-check-input student-program-radio"
                                                               name="student-slot-@ev.EventId-@slot.TimeSlotId"
                                                               value="@program.PlanSessionId"
                                                               id="program-@ev.EventId-@program.PlanSessionId"
                                                               data-program-name="@program.PlanName"
                                                               data-start="@program.BeginDate.ToUnixTimeMilliseconds()"
                                                               data-end="@program.EndDate.ToUnixTimeMilliseconds()"
                                                               checked="@program.IsSelected"
                                                               disabled="@(isFull && !program.IsSelected)" />

                                                        <span class="form-check-label">
                                                            <strong>@program.PlanName</strong>
                                                        </span>

                                                    </div>

                                                    @if (!string.IsNullOrWhiteSpace(program.Description))
                                                    {
                                                        <p class="mb-1 mt-2">
                                                            @program.Description
                                                        </p>
                                                    }

                                                    <small class="text-muted">
                                                        Időpont:
                                                        @program.BeginDate.ToString("HH:mm")
                                                        –
                                                        @program.EndDate.ToString("HH:mm")
                                                        |
                                                        Terem: @program.LocationName
                                                        |
                                                        Kapacitás: @program.Capacity
                                                        |
                                                        Szabad hely: @program.AvailablePlaces
                                                    </small>

                                                    @if (isFull)
                                                    {
                                                        <div class="mt-2">

                                                            @if (program.IsSelected)
                                                            {
                                                                <span class="badge bg-success">
                                                                    Saját foglalásod
                                                                </span>
                                                            }
                                                            else
                                                            {
                                                                <span class="badge bg-danger">
                                                                    Betelt
                                                                </span>
                                                            }

                                                        </div>
                                                    }

                                                </label>
                                            }

                                        </div>

                                    </div>

                                </div>
                            }

                        </div>

                        <div class="alert alert-info">
                            A kiválasztott programok nem ütközhetnek
                            időben, és együtt le kell fedniük
                            az esemény összes idősávját.
                        </div>

                        <div class="student-selection-summary mb-3"></div>

                        @if (ev.HasRegistration)
                        {
                            <button type="submit"
                                    class="btn btn-primary">
                                Módosítások mentése
                            </button>
                        }
                        else
                        {
                            <button type="submit"
                                    class="btn btn-success">
                                Jelentkezés mentése
                            </button>
                        }

                    </form>
                }
                else if (ev.HasRegistration)
                {
                    <div class="alert alert-secondary">
                        A jelentkezés jelenleg nem módosítható.
                    </div>

                    @foreach (var slot in ev.TimeSlots)
                    {
                        var selectedPrograms = slot.Programs
                        .Where(p => p.IsSelected)
                        .ToList();

                        @foreach (var program in selectedPrograms)
                        {
                            <div class="mb-3">
                                <strong>@program.PlanName</strong>
                                – @program.LocationName

                                <span class="text-muted">
                                    (@program.BeginDate.ToString("HH:mm")
                                    –
                                    @program.EndDate.ToString("HH:mm"))
                                </span>
                            </div>
                        }
                    }
                }
                else
                {
                    <div class="alert alert-secondary">
                        A jelentkezés jelenleg nem elérhető.
                    </div>
                }

            </div>
        </div>
    }

</div>


@section Scripts {
    <script src="~/js/student/index.js" asp-append-version="true"></script>
}
@section Styles {
    <link rel="stylesheet" href="~/css/student/index.css"  asp-append-version="true" />
}