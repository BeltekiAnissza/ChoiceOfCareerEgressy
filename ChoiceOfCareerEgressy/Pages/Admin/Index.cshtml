@page
@model ChoiceOfCareerEgressy.Pages.Admin.IndexModel

@using System.Text.Json

@{
    ViewData["Title"] = "Adminisztrátori kezdőlap";

    var dashboardData = new
    {
        branchLabels = Model.BranchChartLabels,
        branchValues = Model.BranchChartValues,
        capacityValues = Model.CapacityChartValues,
        trendLabels = Model.TrendChartLabels,
        trendValues = Model.TrendChartValues
    };

    var dashboardJson = JsonSerializer.Serialize(dashboardData);
}

<style>
    .dashboard-title {
        font-weight: 700;
        letter-spacing: -0.5px;
    }

    .dashboard-card {
        border: none;
        border-radius: 14px;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .dashboard-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08) !important;
        }

    .dashboard-icon {
        width: 52px;
        height: 52px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        font-size: 24px;
    }

    .dashboard-chart {
        position: relative;
        height: 320px;
    }

    .dashboard-chart-wide {
        position: relative;
        height: 300px;
    }

    .dashboard-table th {
        font-size: 13px;
        font-weight: 600;
        color: #6c757d;
        white-space: nowrap;
    }

    .dashboard-table td {
        vertical-align: middle;
    }

    .dashboard-section-title {
        font-size: 18px;
        font-weight: 600;
    }

    .dashboard-progress {
        height: 8px;
        border-radius: 10px;
    }
</style>

<div class="container-fluid py-4">

    <!-- ================================================= -->
    <!-- FEJLÉC -->
    <!-- ================================================= -->

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">

        <div>
            <h2 class="dashboard-title mb-1">
                Adminisztrátori áttekintés
            </h2>

            <p class="text-muted mb-0">
                A pályaorientációs rendszer statisztikái és aktuális adatai.
            </p>
        </div>

        <div>
            <form method="get" class="d-flex align-items-center gap-2">

                <label for="eventId" class="form-label mb-0 text-nowrap">
                    Esemény:
                </label>

                <select id="eventId"
                        name="eventId"
                        class="form-select"
                        onchange="this.form.submit()">

                    <option value="">Összes esemény</option>

                    @foreach (var ev in Model.AvailableEvents)
                    {
                        <option value="@ev.EventId"
                                selected="@(Model.SelectedEventId == ev.EventId)">
                            @ev.EventName
                        </option>
                    }

                </select>

            </form>
        </div>

    </div>

    <!-- ================================================= -->
    <!-- STATISZTIKAI KÁRTYÁK -->
    <!-- ================================================= -->

    <div class="row g-3 mb-4">

        <!-- DIÁKOK -->

        <div class="col-12 col-sm-6 col-xl-4 col-xxl-2">

            <div class="card dashboard-card shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-start">

                        <div>
                            <div class="text-muted small mb-2">Diákok</div>

                            <h2 class="fw-bold mb-0">
                                @Model.StudentCount
                            </h2>
                        </div>

                        <div class="dashboard-icon bg-primary bg-opacity-10 text-primary">
                            <i class="bi bi-mortarboard"></i>
                        </div>

                    </div>

                    <div class="mt-3">
                        <a asp-page="/Admin/Users/Index"
                           class="small text-decoration-none">
                            Diákok kezelése
                            <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>

                </div>

            </div>

        </div>

        <!-- TANÁROK -->

        <div class="col-12 col-sm-6 col-xl-4 col-xxl-2">

            <div class="card dashboard-card shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-start">

                        <div>
                            <div class="text-muted small mb-2">Tanárok</div>

                            <h2 class="fw-bold mb-0">
                                @Model.TeacherCount
                            </h2>
                        </div>

                        <div class="dashboard-icon bg-success bg-opacity-10 text-success">
                            <i class="bi bi-person-workspace"></i>
                        </div>

                    </div>

                    <div class="mt-3">
                        <a asp-page="/Admin/Users/Index"
                           class="small text-decoration-none">
                            Tanárok kezelése
                            <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>

                </div>

            </div>

        </div>

        <!-- PROGRAMOK -->

        <div class="col-12 col-sm-6 col-xl-4 col-xxl-2">

            <div class="card dashboard-card shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-start">

                        <div>
                            <div class="text-muted small mb-2">Programok</div>

                            <h2 class="fw-bold mb-0">
                                @Model.ProgramCount
                            </h2>
                        </div>

                        <div class="dashboard-icon bg-info bg-opacity-10 text-info">
                            <i class="bi bi-calendar2-check"></i>
                        </div>

                    </div>

                    <div class="mt-3">
                        <a asp-page="/Admin/Programs/Index"
                           class="small text-decoration-none">
                            Programok kezelése
                            <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>

                </div>

            </div>

        </div>

        <!-- JELENTKEZÉSEK -->

        <div class="col-12 col-sm-6 col-xl-4 col-xxl-2">

            <div class="card dashboard-card shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-start">

                        <div>
                            <div class="text-muted small mb-2">Jelentkezések</div>

                            <h2 class="fw-bold mb-0">
                                @Model.ApplicationCount
                            </h2>
                        </div>

                        <div class="dashboard-icon bg-warning bg-opacity-10 text-warning">
                            <i class="bi bi-clipboard-check"></i>
                        </div>

                    </div>

                    <div class="mt-3">
                        <a asp-page="/Admin/Registrations/Students/Index"
                           class="small text-decoration-none">
                            Jelentkezések megtekintése
                            <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>

                </div>

            </div>

        </div>

        <!-- ESEMÉNYEK -->

        <div class="col-12 col-sm-6 col-xl-4 col-xxl-2">

            <div class="card dashboard-card shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-start">

                        <div>
                            <div class="text-muted small mb-2">Események</div>

                            <h2 class="fw-bold mb-0">
                                @Model.EventCount
                            </h2>
                        </div>

                        <div class="dashboard-icon bg-danger bg-opacity-10 text-danger">
                            <i class="bi bi-calendar-event"></i>
                        </div>

                    </div>

                    <div class="mt-3">
                        <a asp-page="/Admin/Events/Index"
                           class="small text-decoration-none">
                            Események kezelése
                            <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>

                </div>

            </div>

        </div>

        <!-- FELÜGYELETEK -->

        <div class="col-12 col-sm-6 col-xl-4 col-xxl-2">

            <div class="card dashboard-card shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-start">

                        <div>
                            <div class="text-muted small mb-2">Felügyeletek</div>

                            <h2 class="fw-bold mb-0">
                                @Model.SupervisionCount
                            </h2>
                        </div>

                        <div class="dashboard-icon bg-secondary bg-opacity-10 text-secondary">
                            <i class="bi bi-shield-check"></i>
                        </div>

                    </div>

                    <div class="mt-3">
                        <a asp-page="/Admin/Registrations/Teachers/Index"
                           class="small text-decoration-none">
                            Felügyeletek megtekintése
                            <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- ================================================= -->
    <!-- DIAGRAMOK -->
    <!-- ================================================= -->

    <div class="row g-4 mb-4">

        <!-- JELENTKEZÉSEK ÁGAZATONKÉNT -->

        <div class="col-12 col-xl-7">

            <div class="card dashboard-card shadow-sm h-100">

                <div class="card-header bg-transparent border-0 pt-4 px-4">

                    <h5 class="dashboard-section-title mb-1">
                        Jelentkezések ágazatonként
                    </h5>

                    <p class="text-muted small mb-0">
                        Az egyes ágazatok diákjainak aktív jelentkezései.
                    </p>

                </div>

                <div class="card-body px-4">

                    <div class="dashboard-chart">
                        <canvas id="branchChart"></canvas>
                    </div>

                </div>

            </div>

        </div>

        <!-- PROGRAMOK KIHASZNÁLTSÁGA -->

        <div class="col-12 col-xl-5">

            <div class="card dashboard-card shadow-sm h-100">

                <div class="card-header bg-transparent border-0 pt-4 px-4">

                    <h5 class="dashboard-section-title mb-1">
                        Programok kihasználtsága
                    </h5>

                    <p class="text-muted small mb-0">
                        A programalkalmak telítettsége.
                    </p>

                </div>

                <div class="card-body px-4">

                    <div class="dashboard-chart">
                        <canvas id="capacityChart"></canvas>
                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- ================================================= -->
    <!-- JELENTKEZÉSEK IDŐBELI ALAKULÁSA -->
    <!-- ================================================= -->

    <div class="card dashboard-card shadow-sm mb-4">

        <div class="card-header bg-transparent border-0 pt-4 px-4">

            <h5 class="dashboard-section-title mb-1">
                Jelentkezések időbeli alakulása
            </h5>

            <p class="text-muted small mb-0">
                Az aktív jelentkezések száma napokra bontva.
            </p>

        </div>

        <div class="card-body px-4">

            <div class="dashboard-chart-wide">
                <canvas id="applicationTrendChart"></canvas>
            </div>

        </div>

    </div>

    <!-- ================================================= -->
    <!-- RÉSZLETES STATISZTIKÁK -->
    <!-- ================================================= -->

    <div class="row g-4">

        <!-- LEGNÉPSZERŰBB PROGRAMOK -->

        <div class="col-12 col-xl-7">

            <div class="card dashboard-card shadow-sm h-100">

                <div class="card-header bg-transparent border-0 pt-4 px-4">

                    <h5 class="dashboard-section-title mb-1">
                        Legnépszerűbb programok
                    </h5>

                    <p class="text-muted small mb-0">
                        A legtöbb aktív jelentkezéssel rendelkező programalkalmak.
                    </p>

                </div>

                <div class="card-body">

                    @if (!Model.PopularPrograms.Any())
                    {
                        <div class="alert alert-light text-center">
                            Még nincs megjeleníthető adat.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">

                            <table class="table table-hover dashboard-table">

                                <thead>
                                    <tr>
                                        <th>Program</th>
                                        <th class="text-center">Jelentkezők</th>
                                        <th class="text-center">Kapacitás</th>
                                        <th>Kihasználtság</th>
                                    </tr>
                                </thead>

                                <tbody>

                                    @foreach (var program in Model.PopularPrograms)
                                    {
                                        <tr>

                                            <td>
                                                <strong>@program.Name</strong>
                                            </td>

                                            <td class="text-center">
                                                @program.ApplicationCount
                                            </td>

                                            <td class="text-center">
                                                @program.Capacity
                                            </td>

                                            <td style="min-width: 130px;">

                                                <div class="small mb-1">
                                                    @program.OccupancyPercent.ToString("0.0")%
                                                </div>

                                                <div class="progress dashboard-progress">

                                                    <div class="progress-bar"
                                                         role="progressbar"
                                                         style="width: @(Math.Clamp(program.OccupancyPercent, 0, 100).ToString(System.Globalization.CultureInfo.InvariantCulture))%;"
                                                         aria-valuenow="@Math.Clamp(program.OccupancyPercent, 0, 100)"
                                                         aria-valuemin="0"
                                                         aria-valuemax="100">
                                                    </div>

                                                </div>

                                            </td>

                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>
                    }

                </div>

            </div>

        </div>

        <!-- OSZTÁLYOK AKTIVITÁSA -->

        <div class="col-12 col-xl-5">

            <div class="card dashboard-card shadow-sm h-100">

                <div class="card-header bg-transparent border-0 pt-4 px-4">

                    <h5 class="dashboard-section-title mb-1">
                        Osztályok aktivitása
                    </h5>

                    <p class="text-muted small mb-0">
                        Legalább egy aktív jelentkezéssel rendelkező diákok aránya.
                    </p>

                </div>

                <div class="card-body">

                    @if (!Model.GradeStatistics.Any())
                    {
                        <div class="alert alert-light text-center">
                            Még nincs megjeleníthető adat.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">

                            <table class="table table-hover dashboard-table">

                                <thead>
                                    <tr>
                                        <th>Osztály</th>
                                        <th class="text-center">Diákok</th>
                                        <th>Aktivitás</th>
                                    </tr>
                                </thead>

                                <tbody>

                                    @foreach (var grade in Model.GradeStatistics)
                                    {
                                        <tr>

                                            <td>
                                                <strong>@grade.GradeName</strong>
                                            </td>

                                            <td class="text-center">
                                                @grade.StudentCount
                                            </td>

                                            <td style="min-width: 130px;">

                                                <div class="small mb-1">
                                                    @grade.ActiveStudentCount /
                                                    @grade.StudentCount
                                                    (@grade.ActivityPercent.ToString("0.0")%)
                                                </div>

                                                <div class="progress dashboard-progress">

                                                    <div class="progress-bar bg-success"
                                                         role="progressbar"
                                                         style="width: @(Math.Clamp(grade.ActivityPercent, 0, 100).ToString(System.Globalization.CultureInfo.InvariantCulture))%;"
                                                         aria-valuenow="@Math.Clamp(grade.ActivityPercent, 0, 100)"
                                                         aria-valuemin="0"
                                                         aria-valuemax="100">
                                                    </div>

                                                </div>

                                            </td>

                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>
                    }

                </div>

            </div>

        </div>

    </div>

</div>

<!-- ================================================= -->
<!-- DASHBOARD JSON ADATOK -->
<!-- ================================================= -->

<div id="dashboardData"
     data-json="@dashboardJson"
     hidden>
</div>

@section Scripts
{
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            // =====================================
            // DASHBOARD ADATOK BEOLVASÁSA
            // =====================================

            const dataElement = document.getElementById("dashboardData");

            if (!dataElement) {
                console.error("Nem található a dashboardData elem.");
                return;
            }

            let data;

            try {
                data = JSON.parse(dataElement.dataset.json);
            }
            catch (error) {
                console.error("Hiba a Dashboard JSON-adatainak feldolgozásakor:", error);
                return;
            }

            // =====================================
            // CHART.JS ELLENŐRZÉSE
            // =====================================

            if (typeof Chart === "undefined") {
                console.error("A Chart.js nem töltődött be.");
                return;
            }

            // =====================================
            // JELENTKEZÉSEK ÁGAZATONKÉNT
            // =====================================

            const branchChart = document.getElementById("branchChart");

            if (branchChart) {

                new Chart(branchChart, {

                    type: "bar",

                    data: {
                        labels: data.branchLabels,

                        datasets: [{
                            label: "Aktív jelentkezések",
                            data: data.branchValues,
                            backgroundColor: "#3b82f6",
                            borderRadius: 6
                        }]
                    },

                    options: {
                        responsive: true,
                        maintainAspectRatio: false,

                        plugins: {
                            legend: {
                                display: false
                            }
                        },

                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: {
                                    precision: 0
                                }
                            }
                        }
                    }

                });
            }

            // =====================================
            // PROGRAMOK KIHASZNÁLTSÁGA
            // =====================================

            const capacityChart = document.getElementById("capacityChart");

            if (capacityChart) {

                new Chart(capacityChart, {

                    type: "doughnut",

                    data: {
                        labels: [
                            "Betelt",
                            "Részben feltöltött",
                            "Jelentkezés nélküli"
                        ],

                        datasets: [{
                            data: data.capacityValues,

                            backgroundColor: [
                                "#ef4444",
                                "#f59e0b",
                                "#10b981"
                            ],

                            borderWidth: 0
                        }]
                    },

                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        cutout: "70%",

                        plugins: {
                            legend: {
                                position: "bottom"
                            }
                        }
                    }

                });
            }

            // =====================================
            // JELENTKEZÉSEK IDŐBELI ALAKULÁSA
            // =====================================

            const trendChart = document.getElementById("applicationTrendChart");

            if (trendChart) {

                new Chart(trendChart, {

                    type: "line",

                    data: {
                        labels: data.trendLabels,

                        datasets: [{
                            label: "Aktív jelentkezések",
                            data: data.trendValues,

                            borderColor: "#6366f1",
                            backgroundColor: "rgba(99, 102, 241, 0.1)",

                            borderWidth: 2,
                            fill: true,
                            tension: 0.3,
                            pointRadius: 4,
                            pointHoverRadius: 6
                        }]
                    },

                    options: {
                        responsive: true,
                        maintainAspectRatio: false,

                        plugins: {
                            legend: {
                                display: false
                            }
                        },

                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: {
                                    precision: 0
                                }
                            }
                        }
                    }

                });
            }

        });
    </script>
}