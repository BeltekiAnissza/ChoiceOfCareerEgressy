@page
@model ChoiceOfCareerEgressy.Pages.Events.IndexModel

@{
    ViewData["Title"] = "Események és programok";
}

<div class="container mt-4">

    <!-- FEJLÉC -->

    <div class="d-flex justify-content-between
                align-items-start flex-wrap gap-3 mb-4">

        <div>
            <h2>Események és programok</h2>

            <p class="text-muted mb-0">
                A pályaorientációs napok programjai,
                jelentkezési adatai és kapacitásai.
            </p>
        </div>

        <!-- ÖSSZES PROGRAM TÖRLÉSE -->

        <form method="post"
              asp-page-handler="DeleteAllPrograms"
              id="deleteAllProgramsForm">

            <button type="button"
                    class="btn btn-danger"
                    disabled="@(Model.TotalProgramCount == 0)"
                    onclick="confirmDeleteAllPrograms()">

                Összes program törlése
                (@Model.TotalProgramCount)

            </button>

        </form>

    </div>

    <!-- VISSZAJELZÉSEK -->
    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success">
            @success
        </div>
    }

    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger">
            @error
        </div>
    }

    @if (!Model.Events.Any())
    {
        <div class="alert alert-info">
            Jelenleg nincs létrehozott esemény.
        </div>
    }

    <!-- ESEMÉNYEK -->
    @foreach (var ev in Model.Events)
    {
        <div class="card shadow-sm mb-4">

            <!-- ESEMÉNY FEJLÉC -->

            <div class="card-header">

                <div class="d-flex justify-content-between
                                align-items-center flex-wrap gap-3">

                    <div>
                        <h4 class="mb-1">
                            @ev.EventName
                        </h4>

                        <small>
                            @ev.EventDate.ToString("yyyy.MM.dd.")
                        </small>
                    </div>

                    <div class="d-flex align-items-center
                                    flex-wrap gap-2">

                        @if (ev.IsRegistrationEnabled)
                        {
                            <span class="badge bg-success">
                                Jelentkezés engedélyezve
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">
                                Jelentkezés letiltva
                            </span>
                        }

                        <!-- JELENTKEZÉS ÁLLAPOTÁNAK MÓDOSÍTÁSA -->

                        <form method="post"
                              asp-page-handler="ToggleRegistration">

                            <input type="hidden"
                                   name="eventId"
                                   value="@ev.EventId" />

                            @if (ev.IsRegistrationEnabled)
                            {
                                <button type="submit"
                                        class="btn btn-outline-danger btn-sm"
                                        onclick="return confirm('Biztosan letiltod a jelentkezést ehhez az eseményhez?')">

                                    Jelentkezés letiltása

                                </button>
                            }
                            else
                            {
                                <button type="submit"
                                        class="btn btn-success btn-sm"
                                        onclick="return confirm('Biztosan engedélyezed a jelentkezést ehhez az eseményhez?')">

                                    Jelentkezés engedélyezése

                                </button>
                            }

                        </form>

                    </div>

                </div>

            </div>

            <!-- ESEMÉNY TARTALMA -->

            <div class="card-body">

                <p class="mb-3">
                    <strong>Jelentkezési időszak:</strong>

                    @ev.RegistrationStart.ToString("yyyy.MM.dd. HH:mm")
                    –
                    @ev.RegistrationEnd.ToString("yyyy.MM.dd. HH:mm")
                </p>

                @if (ev.IsRegistrationEnabled)
                {
                    <div class="alert alert-info">
                        A jelentkezés engedélyezve van.
                        A diákok a megadott jelentkezési
                        időszakon belül jelentkezhetnek.
                    </div>
                }
                else
                {
                    <div class="alert alert-warning">
                        A jelentkezés jelenleg le van tiltva.
                        A diákok nem tudnak új jelentkezést
                        leadni vagy módosítani.
                    </div>
                }

                @if (!ev.TimeSlots.Any())
                {
                    <div class="alert alert-warning">
                        Ehhez az eseményhez még nincs idősáv.
                    </div>
                }

                <!-- IDŐSÁVOK -->
                @foreach (var slot in ev.TimeSlots)
                {
                    <div class="mb-4">

                        <h5 class="border-bottom pb-2">

                            @slot.TimeSlotName

                            <small class="text-muted">
                                (@slot.BeginDate.ToString("HH:mm")
                                –
                                @slot.EndDate.ToString("HH:mm"))
                            </small>

                        </h5>

                        @if (!slot.Programs.Any())
                        {
                            <p class="text-muted">
                                Ebben az idősávban még nincs program.
                            </p>
                        }
                        else
                        {
                            <div class="table-responsive">

                                <table class="table table-striped
                                                          table-hover align-middle">

                                    <thead>
                                        <tr>
                                            <th>Program</th>
                                            <th>Terem</th>
                                            <th>Nem</th>
                                            <th>Ágazat</th>

                                            <th class="text-center">
                                                Kapacitás
                                            </th>

                                            <th class="text-center">
                                                Jelentkezők
                                            </th>

                                            <th class="text-center">
                                                Szabad hely
                                            </th>
                                        </tr>
                                    </thead>

                                    <tbody>

                                        @foreach (var program in slot.Programs)
                                        {
                                            <tr>

                                                <td>
                                                    <strong>
                                                        @program.PlanName
                                                    </strong>

                                                    @if (!string.IsNullOrWhiteSpace(
                                                                                        program.Description))
                                                    {
                                                        <div class="small text-muted">
                                                            @program.Description
                                                        </div>
                                                    }
                                                </td>

                                                <td>
                                                    @program.LocationName
                                                </td>

                                                <td>
                                                    @program.SexName
                                                </td>

                                                <td>
                                                    @program.BranchName
                                                </td>

                                                <td class="text-center">
                                                    @program.Capacity
                                                </td>

                                                <td class="text-center">
                                                    @program.RegisteredCount
                                                </td>

                                                <td class="text-center">

                                                    @if (program.AvailablePlaces == 0)
                                                    {
                                                        <span class="badge bg-danger">
                                                            Betelt
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-success">
                                                            @program.AvailablePlaces
                                                        </span>
                                                    }

                                                </td>

                                            </tr>
                                        }

                                    </tbody>

                                </table>

                            </div>
                        }

                    </div>
                }

            </div>

        </div>
    }

</div>

@section Scripts
{
    <script>
        function confirmDeleteAllPrograms() {

            const firstConfirmation = confirm(
                "FIGYELEM!\n\n" +
                "Biztosan törölni szeretnéd az ÖSSZES programot?\n\n" +
                "A programokhoz tartozó jelentkezések és " +
                "felügyeletek is törlődnek.\n\n" +
                "A művelet nem vonható vissza!"
            );

            if (!firstConfirmation) {
                return;
            }

            const confirmationText = prompt(
                "A törlés megerősítéséhez írd be:\n\nTÖRLÉS"
            );

            if (confirmationText !== "TÖRLÉS") {

                alert(
                    "A törlés megszakítva.\n" +
                    "Nem történt adatváltozás."
                );

                return;
            }

            document.getElementById(
                "deleteAllProgramsForm"
            ).requestSubmit();
        }
    </script>
}