@page
@model ChoiceOfCareerEgressy.Pages.Events.CreateModel

@{
    ViewData["Title"] = "Esemény létrehozása";
}

<div class="container mt-4">

    <!-- ========================================= -->
    <!-- FEJLÉC                                    -->
    <!-- ========================================= -->

    <div class="mb-4">

        <h2 class="fw-bold">
            <i class="bi bi-calendar-plus me-2"></i>
            Új esemény létrehozása
        </h2>

        <p class="text-muted">
            Add meg a pályaorientációs nap adatait,
            a jelentkezési időszakot és az idősávokat.
            Legalább két idősáv megadása kötelező.
        </p>

    </div>

    <form method="post" id="createEventForm">

        <div asp-validation-summary="All"
             class="text-danger mb-3">
        </div>

        <!-- ========================================= -->
        <!-- ESEMÉNY ADATAI                            -->
        <!-- ========================================= -->

        <div class="card shadow-sm mb-4">

            <div class="card-header">

                <h5 class="mb-0">
                    <i class="bi bi-calendar-event me-2"></i>
                    Esemény adatai
                </h5>

            </div>

            <div class="card-body">

                <!-- ESEMÉNY NEVE -->

                <div class="mb-3">

                    <label asp-for="EventInput.EventName"
                           class="form-label fw-semibold">
                        Esemény neve
                    </label>

                    <input asp-for="EventInput.EventName"
                           class="form-control"
                           placeholder="Pályaorientációs nap 2026"
                           required />

                    <span asp-validation-for="EventInput.EventName"
                          class="text-danger">
                    </span>

                </div>

                <!-- ESEMÉNY DÁTUMA -->

                <div class="mb-3">

                    <label asp-for="EventDateText"
                           class="form-label fw-semibold">
                        Esemény dátuma
                    </label>

                    <input asp-for="EventDateText"
                           type="text"
                           class="form-control"
                           placeholder="2026/12/17"
                           pattern="[0-9]{4}/[0-9]{2}/[0-9]{2}"
                           title="A dátum formátuma: ÉÉÉÉ/HH/NN"
                           inputmode="numeric"
                           maxlength="10"
                           autocomplete="off"
                           required />

                    <div class="form-text">
                        Példa: 2026/12/17
                    </div>

                    <span asp-validation-for="EventDateText"
                          class="text-danger">
                    </span>

                </div>

                <!-- JELENTKEZÉS ENGEDÉLYEZÉSE -->

                <div class="form-check">

                    <input asp-for="EventInput.IsRegistrationEnabled"
                           class="form-check-input" />

                    <label asp-for="EventInput.IsRegistrationEnabled"
                           class="form-check-label">
                        Jelentkezés engedélyezése
                    </label>

                </div>

            </div>

        </div>

        <!-- ========================================= -->
        <!-- JELENTKEZÉSI IDŐSZAK                      -->
        <!-- ========================================= -->

        <div class="card shadow-sm mb-4">

            <div class="card-header">

                <h5 class="mb-0">
                    <i class="bi bi-clock-history me-2"></i>
                    Jelentkezési időszak
                </h5>

            </div>

            <div class="card-body">

                <p class="text-muted small">
                    A jelentkezés kezdő és záró dátumát külön add meg.
                    Az időpontokat 24 órás formátumban kell beírni.
                </p>

                <div class="row">

                    <!-- JELENTKEZÉS KEZDETE -->

                    <div class="col-md-6 mb-3">

                        <label class="form-label fw-semibold">
                            Jelentkezés kezdete
                        </label>

                        <div class="row g-2">

                            <div class="col-sm-7">

                                <input asp-for="RegistrationStartDateText"
                                       type="text"
                                       class="form-control"
                                       placeholder="2026/12/01"
                                       pattern="[0-9]{4}/[0-9]{2}/[0-9]{2}"
                                       title="Dátum: ÉÉÉÉ/HH/NN"
                                       inputmode="numeric"
                                       maxlength="10"
                                       autocomplete="off"
                                       aria-label="Jelentkezés kezdő dátuma"
                                       required />

                            </div>

                            <div class="col-sm-5">

                                <input asp-for="RegistrationStartTime"
                                       type="text"
                                       class="form-control"
                                       placeholder="08:00"
                                       pattern="([01][0-9]|2[0-3]):[0-5][0-9]"
                                       title="24 órás időformátum, például 08:00."
                                       inputmode="numeric"
                                       maxlength="5"
                                       autocomplete="off"
                                       aria-label="Jelentkezés kezdő időpontja"
                                       required />

                            </div>

                        </div>

                        <span asp-validation-for="RegistrationStartDateText"
                              class="text-danger">
                        </span>

                        <span asp-validation-for="RegistrationStartTime"
                              class="text-danger">
                        </span>

                    </div>

                    <!-- JELENTKEZÉS VÉGE -->

                    <div class="col-md-6 mb-3">

                        <label class="form-label fw-semibold">
                            Jelentkezés vége
                        </label>

                        <div class="row g-2">

                            <div class="col-sm-7">

                                <input asp-for="RegistrationEndDateText"
                                       type="text"
                                       class="form-control"
                                       placeholder="2026/12/16"
                                       pattern="[0-9]{4}/[0-9]{2}/[0-9]{2}"
                                       title="Dátum: ÉÉÉÉ/HH/NN"
                                       inputmode="numeric"
                                       maxlength="10"
                                       autocomplete="off"
                                       aria-label="Jelentkezés záró dátuma"
                                       required />

                            </div>

                            <div class="col-sm-5">

                                <input asp-for="RegistrationEndTime"
                                       type="text"
                                       class="form-control"
                                       placeholder="16:00"
                                       pattern="([01][0-9]|2[0-3]):[0-5][0-9]"
                                       title="24 órás időformátum, például 16:00."
                                       inputmode="numeric"
                                       maxlength="5"
                                       autocomplete="off"
                                       aria-label="Jelentkezés záró időpontja"
                                       required />

                            </div>

                        </div>

                        <span asp-validation-for="RegistrationEndDateText"
                              class="text-danger">
                        </span>

                        <span asp-validation-for="RegistrationEndTime"
                              class="text-danger">
                        </span>

                    </div>

                </div>

            </div>

        </div>

        <!-- ========================================= -->
        <!-- IDŐSÁVOK                                 -->
        <!-- ========================================= -->

        <div class="card shadow-sm mb-4">

            <div class="card-header">

                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">

                    <h5 class="mb-0">
                        <i class="bi bi-clock me-2"></i>
                        Idősávok
                    </h5>

                    <span class="badge bg-primary"
                          id="timeSlotCount">
                        @Model.TimeSlots.Count idősáv
                    </span>

                </div>

            </div>

            <div class="card-body">

                <p class="text-muted small">
                    Legalább két idősávot kell megadni.
                    További idősávokat korlátozás nélkül hozzáadhatsz.
                    Az idősávok nem fedhetik egymást.
                </p>

                <!-- IDŐSÁVOK LISTÁJA -->

                <div id="timeSlotsContainer">

                    @for (int i = 0; i < Model.TimeSlots.Count; i++)
                    {
                        <div class="card border mb-3 time-slot-card">

                            <div class="card-header bg-light">

                                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">

                                    <h6 class="mb-0 fw-bold time-slot-title">
                                        @(i + 1). idősáv
                                    </h6>

                                    <button type="button"
                                            class="btn btn-outline-danger btn-sm remove-time-slot">

                                        <i class="bi bi-trash me-1"></i>
                                        Törlés

                                    </button>

                                </div>

                            </div>

                            <div class="card-body">

                                <!-- IDŐSÁV NEVE -->

                                <div class="mb-3">

                                    <label class="form-label fw-semibold">
                                        Idősáv neve
                                    </label>

                                    <input type="text"
                                           class="form-control time-slot-name"
                                           name="TimeSlots[@i].TimeSlotName"
                                           id="TimeSlots_@(i)__TimeSlotName"
                                           value="@Model.TimeSlots[i].TimeSlotName"
                                           placeholder="@(i + 1). idősáv"
                                           maxlength="100"
                                           required />

                                </div>

                                <div class="row">

                                    <!-- KEZDÉS -->

                                    <div class="col-md-6 mb-3">

                                        <label class="form-label fw-semibold">
                                            Kezdés
                                        </label>

                                        <input type="text"
                                               class="form-control time-slot-start"
                                               name="TimeSlots[@i].StartTime"
                                               id="TimeSlots_@(i)__StartTime"
                                               value="@Model.TimeSlots[i].StartTime"
                                               placeholder="08:00"
                                               pattern="([01][0-9]|2[0-3]):[0-5][0-9]"
                                               title="24 órás időformátum, például 08:00."
                                               inputmode="numeric"
                                               maxlength="5"
                                               autocomplete="off"
                                               required />

                                    </div>

                                    <!-- BEFEJEZÉS -->

                                    <div class="col-md-6 mb-3">

                                        <label class="form-label fw-semibold">
                                            Befejezés
                                        </label>

                                        <input type="text"
                                               class="form-control time-slot-end"
                                               name="TimeSlots[@i].EndTime"
                                               id="TimeSlots_@(i)__EndTime"
                                               value="@Model.TimeSlots[i].EndTime"
                                               placeholder="10:00"
                                               pattern="([01][0-9]|2[0-3]):[0-5][0-9]"
                                               title="24 órás időformátum, például 10:00."
                                               inputmode="numeric"
                                               maxlength="5"
                                               autocomplete="off"
                                               required />

                                    </div>

                                </div>

                            </div>

                        </div>
                    }

                </div>

                <!-- IDŐSÁV HOZZÁADÁSA -->

                <button type="button"
                        class="btn btn-outline-primary"
                        id="addTimeSlotButton">

                    <i class="bi bi-plus-circle me-1"></i>
                    Új idősáv hozzáadása

                </button>

                <div class="form-text mt-2">
                    Az új idősáv az esemény napjára kerül.
                    Csak a kezdési és befejezési időpontot kell megadnod.
                </div>

            </div>

        </div>

        <!-- ========================================= -->
        <!-- GOMBOK                                   -->
        <!-- ========================================= -->

        <div class="d-flex flex-wrap gap-2 mb-4">

            <button type="submit"
                    class="btn btn-success">

                <i class="bi bi-check-circle me-1"></i>
                Esemény létrehozása

            </button>

            <a asp-page="/Admin/Events/Index"
               class="btn btn-secondary">

                <i class="bi bi-arrow-left me-1"></i>
                Mégse

            </a>

        </div>

    </form>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script src="~/js/admin/events/create.js"
            asp-append-version="true"></script>
}