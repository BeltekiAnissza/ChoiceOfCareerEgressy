@page "{id:int}"
@model ChoiceOfCareerEgressy.Pages.Admin.Events.EditModel

@{
    ViewData["Title"] = "Esemény szerkesztése";
}

<div class="container mt-4 mb-5">

    <!-- ========================================= -->
    <!-- FEJLÉC                                    -->
    <!-- ========================================= -->

    <div class="mb-4">

        <h2 class="fw-bold">
            <i class="bi bi-pencil-square me-2"></i>
            Esemény szerkesztése
        </h2>

        <p class="text-muted">
            Módosíthatod az esemény adatait, a jelentkezési időszakot
            és az idősávokat.
        </p>

    </div>

    <!-- ========================================= -->
    <!-- FIGYELMEZTETÉS                            -->
    <!-- ========================================= -->

    <div class="alert alert-info">

        <i class="bi bi-info-circle me-2"></i>

        <strong>Fontos:</strong>

        A már használatban lévő idősávok kezdési és befejezési
        időpontja nem módosítható, és ezek az idősávok nem törölhetők.

        Az idősávok neve azonban továbbra is szerkeszthető.

    </div>

    <!-- ========================================= -->
    <!-- ŰRLAP                                    -->
    <!-- ========================================= -->

    <form method="post" id="editEventForm">

        <input type="hidden" asp-for="EventId" />

        <div asp-validation-summary="All"
             class="text-danger mb-3">
        </div>

        <!-- ========================================= -->
        <!-- ESEMÉNY ADATAI                            -->
        <!-- ========================================= -->

        <div class="card shadow-sm mb-4">

            <div class="card-header">

                <h5 class="mb-0">
                    <i class="bi bi-calendar-event me-2"></i>
                    Esemény adatai
                </h5>

            </div>

            <div class="card-body">

                <!-- ESEMÉNY NEVE -->

                <div class="mb-3">

                    <label asp-for="EventInput.EventName"
                           class="form-label fw-semibold">
                        Esemény neve
                    </label>

                    <input asp-for="EventInput.EventName"
                           class="form-control"
                           maxlength="200"
                           required />

                    <span asp-validation-for="EventInput.EventName"
                          class="text-danger">
                    </span>

                </div>

                <!-- ESEMÉNY DÁTUMA -->

                <div class="mb-3">

                    <label asp-for="EventDateText"
                           class="form-label fw-semibold">
                        Esemény dátuma
                    </label>

                    <input asp-for="EventDateText"
                           type="text"
                           class="form-control"
                           placeholder="2026/12/17"
                           pattern="[0-9]{4}/[0-9]{2}/[0-9]{2}"
                           title="A dátum formátuma: ÉÉÉÉ/HH/NN"
                           inputmode="numeric"
                           maxlength="10"
                           autocomplete="off"
                           required />

                    <div class="form-text">
                        Példa: 2026/12/17.
                        A dátum csak akkor módosítható,
                        ha az eseményhez még nem tartoznak
                        programalkalmak vagy felügyeleti helyek.
                    </div>

                    <span asp-validation-for="EventDateText"
                          class="text-danger">
                    </span>

                </div>

            </div>

        </div>

        <!-- ========================================= -->
        <!-- JELENTKEZÉSI IDŐSZAK                      -->
        <!-- ========================================= -->

        <div class="card shadow-sm mb-4">

            <div class="card-header">

                <h5 class="mb-0">
                    <i class="bi bi-clock-history me-2"></i>
                    Jelentkezési időszak
                </h5>

            </div>

            <div class="card-body">

                <p class="text-muted small">
                    A jelentkezési időszaknak az esemény
                    első idősávja előtt le kell zárulnia.
                </p>

                <div class="row">

                    <!-- JELENTKEZÉS KEZDETE -->

                    <div class="col-md-6 mb-3">

                        <label class="form-label fw-semibold">
                            Jelentkezés kezdete
                        </label>

                        <div class="row g-2">

                            <div class="col-sm-7">

                                <input asp-for="RegistrationStartDateText"
                                       type="text"
                                       class="form-control"
                                       placeholder="2026/12/01"
                                       pattern="[0-9]{4}/[0-9]{2}/[0-9]{2}"
                                       title="Dátum: ÉÉÉÉ/HH/NN"
                                       inputmode="numeric"
                                       maxlength="10"
                                       autocomplete="off"
                                       aria-label="Jelentkezés kezdő dátuma"
                                       required />

                            </div>

                            <div class="col-sm-5">

                                <input asp-for="RegistrationStartTime"
                                       type="text"
                                       class="form-control"
                                       placeholder="08:00"
                                       pattern="([01][0-9]|2[0-3]):[0-5][0-9]"
                                       title="24 órás időformátum, például 08:00."
                                       inputmode="numeric"
                                       maxlength="5"
                                       autocomplete="off"
                                       aria-label="Jelentkezés kezdő időpontja"
                                       required />

                            </div>

                        </div>

                        <span asp-validation-for="RegistrationStartDateText"
                              class="text-danger">
                        </span>

                        <span asp-validation-for="RegistrationStartTime"
                              class="text-danger">
                        </span>

                    </div>

                    <!-- JELENTKEZÉS VÉGE -->

                    <div class="col-md-6 mb-3">

                        <label class="form-label fw-semibold">
                            Jelentkezés vége
                        </label>

                        <div class="row g-2">

                            <div class="col-sm-7">

                                <input asp-for="RegistrationEndDateText"
                                       type="text"
                                       class="form-control"
                                       placeholder="2026/12/16"
                                       pattern="[0-9]{4}/[0-9]{2}/[0-3][0-9]"
                                       title="Dátum: ÉÉÉÉ/HH/NN"
                                       inputmode="numeric"
                                       maxlength="10"
                                       autocomplete="off"
                                       aria-label="Jelentkezés záró dátuma"
                                       required />

                            </div>

                            <div class="col-sm-5">

                                <input asp-for="RegistrationEndTime"
                                       type="text"
                                       class="form-control"
                                       placeholder="16:00"
                                       pattern="([01][0-9]|2[0-3]):[0-5][0-9]"
                                       title="24 órás időformátum, például 16:00."
                                       inputmode="numeric"
                                       maxlength="5"
                                       autocomplete="off"
                                       aria-label="Jelentkezés záró időpontja"
                                       required />

                            </div>

                        </div>

                        <span asp-validation-for="RegistrationEndDateText"
                              class="text-danger">
                        </span>

                        <span asp-validation-for="RegistrationEndTime"
                              class="text-danger">
                        </span>

                    </div>

                </div>

            </div>

        </div>

        <!-- ========================================= -->
        <!-- IDŐSÁVOK                                 -->
        <!-- ========================================= -->

        <div class="card shadow-sm mb-4">

            <div class="card-header">

                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">

                    <h5 class="mb-0">
                        <i class="bi bi-clock me-2"></i>
                        Idősávok
                    </h5>

                    <span class="badge bg-primary"
                          id="timeSlotCount">
                        @Model.TimeSlots.Count idősáv
                    </span>

                </div>

            </div>

            <div class="card-body">

                <p class="text-muted small">
                    Legalább két idősávnak meg kell maradnia.
                    Új idősávokat korlátozás nélkül hozzáadhatsz.
                </p>

                <!-- IDŐSÁVOK LISTÁJA -->

                <div id="timeSlotsContainer">

                    @for (int i = 0; i < Model.TimeSlots.Count; i++)
                    {
                        var slot = Model.TimeSlots[i];

                        <div class="card border mb-3 time-slot-card"
                             data-protected="@slot.IsProtected.ToString().ToLowerInvariant()">

                            <!-- IDŐSÁV FEJLÉCE -->

                            <div class="card-header bg-light">

                                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">

                                    <h6 class="mb-0 fw-bold time-slot-title">
                                        @(i + 1). idősáv
                                    </h6>

                                    <div class="d-flex flex-wrap align-items-center gap-2">

                                        @if (slot.IsProtected)
                                        {
                                            <span class="badge bg-warning text-dark">

                                                <i class="bi bi-lock-fill me-1"></i>
                                                Használatban

                                            </span>
                                        }

                                        <button type="button"
                                                class="btn btn-outline-danger btn-sm remove-time-slot"
                                                disabled="@slot.IsProtected">

                                            <i class="bi bi-trash me-1"></i>
                                            Törlés

                                        </button>

                                    </div>

                                </div>

                            </div>

                            <!-- IDŐSÁV ADATAI -->

                            <div class="card-body">

                                <!-- AZONOSÍTÓ -->

                                <input type="hidden"
                                       class="time-slot-id"
                                       name="TimeSlots[@i].TimeSlotId"
                                       value="@slot.TimeSlotId" />

                                <!-- IDŐSÁV NEVE -->

                                <div class="mb-3">

                                    <label class="form-label fw-semibold">
                                        Idősáv neve
                                    </label>

                                    <input type="text"
                                           class="form-control time-slot-name"
                                           name="TimeSlots[@i].TimeSlotName"
                                           value="@slot.TimeSlotName"
                                           maxlength="100"
                                           required />

                                </div>

                                <div class="row">

                                    <!-- KEZDÉS -->

                                    <div class="col-md-6 mb-3">

                                        <label class="form-label fw-semibold">
                                            Kezdés
                                        </label>

                                        <input type="text"
                                               class="form-control time-slot-start"
                                               name="TimeSlots[@i].StartTime"
                                               value="@slot.StartTime"
                                               placeholder="08:00"
                                               pattern="([01][0-9]|2[0-3]):[0-5][0-9]"
                                               title="24 órás időformátum, például 08:00."
                                               inputmode="numeric"
                                               maxlength="5"
                                               autocomplete="off"
                                               readonly="@slot.IsProtected"
                                               required />

                                    </div>

                                    <!-- BEFEJEZÉS -->

                                    <div class="col-md-6 mb-3">

                                        <label class="form-label fw-semibold">
                                            Befejezés
                                        </label>

                                        <input type="text"
                                               class="form-control time-slot-end"
                                               name="TimeSlots[@i].EndTime"
                                               value="@slot.EndTime"
                                               placeholder="10:00"
                                               pattern="([01][0-9]|2[0-3]):[0-5][0-9]"
                                               title="24 órás időformátum, például 10:00."
                                               inputmode="numeric"
                                               maxlength="5"
                                               autocomplete="off"
                                               readonly="@slot.IsProtected"
                                               required />

                                    </div>

                                </div>

                                @if (slot.IsProtected)
                                {
                                    <div class="alert alert-warning py-2 mb-0 small">

                                        <i class="bi bi-info-circle me-1"></i>

                                        Ehhez az idősávhoz már tartozik program
                                        vagy felügyeleti hely, ezért az időpontjai
                                        nem módosíthatók, és nem törölhető.

                                    </div>
                                }

                            </div>

                        </div>
                    }

                </div>

                <!-- ÚJ IDŐSÁV -->

                <button type="button"
                        class="btn btn-outline-primary"
                        id="addTimeSlotButton">

                    <i class="bi bi-plus-circle me-1"></i>
                    Új idősáv hozzáadása

                </button>

                <div class="form-text mt-2">
                    Az új idősávhoz add meg a nevét,
                    valamint a kezdési és befejezési időpontját.
                </div>

            </div>

        </div>

        <!-- ========================================= -->
        <!-- MENTÉS ÉS MÉGSE                          -->
        <!-- ========================================= -->

        <div class="d-flex flex-wrap gap-2">

            <button type="submit"
                    class="btn btn-success">

                <i class="bi bi-check-circle me-1"></i>
                Módosítások mentése

            </button>

            <a asp-page="/Admin/Events/Index"
               class="btn btn-secondary">

                <i class="bi bi-arrow-left me-1"></i>
                Mégse

            </a>

        </div>

    </form>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script src="~/js/admin/events/edit.js"
            asp-append-version="true"></script>
}