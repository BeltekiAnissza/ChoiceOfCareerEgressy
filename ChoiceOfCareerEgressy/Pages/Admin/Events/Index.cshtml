@page
@model ChoiceOfCareerEgressy.Pages.Admin.Events.IndexModel

@{
    ViewData["Title"] = "Események kezelése";
}

<div class="container-fluid">

    <!-- ========================================= -->
    <!-- FEJLÉC                                    -->
    <!-- ========================================= -->

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-calendar-event me-2"></i>
                Események kezelése
            </h2>

            <p class="text-muted mb-0">
                Események megtekintése, szerkesztése, jelentkezések kezelése és törlése.
            </p>
        </div>

        <a asp-page="/Admin/Events/Create"
           class="btn btn-primary">

            <i class="bi bi-plus-circle me-1"></i>
            Új esemény

        </a>

    </div>

    <!-- ========================================= -->
    <!-- SIKERES MŰVELET ÜZENETE                    -->
    <!-- ========================================= -->
    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            <i class="bi bi-check-circle-fill me-2"></i>

            @Model.SuccessMessage

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Bezárás">
            </button>

        </div>
    }

    <!-- ========================================= -->
    <!-- HIBAÜZENET                                -->
    <!-- ========================================= -->
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">

            <i class="bi bi-exclamation-triangle-fill me-2"></i>

            @Model.ErrorMessage

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Bezárás">
            </button>

        </div>
    }

    <!-- ========================================= -->
    <!-- ESEMÉNYEK LISTÁJA                         -->
    <!-- ========================================= -->

    <div class="card shadow-sm border-0">

        <div class="card-header bg-white py-3">

            <div class="d-flex justify-content-between align-items-center">

                <h5 class="fw-semibold mb-0">

                    <i class="bi bi-list-ul me-2"></i>
                    Események

                </h5>

                <span class="badge bg-primary rounded-pill">
                    @Model.Events.Count db
                </span>

            </div>

        </div>

        <div class="card-body p-0">

            @if (Model.Events.Count == 0)
            {
                <!-- ========================================= -->
                <!-- NINCS ESEMÉNY                             -->
                <!-- ========================================= -->

                <div class="text-center py-5 px-3">

                    <i class="bi bi-calendar-x display-4 text-muted"></i>

                    <h5 class="mt-3">
                        Még nincs létrehozott esemény.
                    </h5>

                    <p class="text-muted">
                        Hozd létre az első eseményt az új esemény gombbal.
                    </p>

                    <a asp-page="/Admin/Events/Create"
                       class="btn btn-primary">

                        <i class="bi bi-plus-circle me-1"></i>
                        Új esemény létrehozása

                    </a>

                </div>
            }
            else
            {
                <!-- ========================================= -->
                <!-- ESEMÉNYEK TÁBLÁZATA                       -->
                <!-- ========================================= -->

                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>
                                <th class="ps-3">
                                    Esemény neve
                                </th>

                                <th>
                                    Esemény dátuma
                                </th>

                                <th>
                                    Jelentkezési időszak
                                </th>

                                <th>
                                    Jelentkezés állapota
                                </th>

                                <th class="text-end pe-3">
                                    Műveletek
                                </th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var eventItem in Model.Events)
                            {
                                <tr>

                                    <!-- ========================================= -->
                                    <!-- ESEMÉNY NEVE                              -->
                                    <!-- ========================================= -->

                                    <td class="ps-3">

                                        <div class="fw-semibold">
                                            @eventItem.EventName
                                        </div>

                                        <small class="text-muted">
                                            Azonosító: @eventItem.EventId
                                        </small>

                                    </td>

                                    <!-- ========================================= -->
                                    <!-- ESEMÉNY DÁTUMA                            -->
                                    <!-- ========================================= -->

                                    <td>

                                        <i class="bi bi-calendar3 me-1 text-muted"></i>

                                        @eventItem.EventDate.ToString("yyyy. MM. dd.")

                                    </td>

                                    <!-- ========================================= -->
                                    <!-- JELENTKEZÉSI IDŐSZAK                      -->
                                    <!-- ========================================= -->

                                    <td>

                                        <div class="small">

                                            <div class="mb-1">

                                                <i class="bi bi-play-circle me-1 text-success"></i>

                                                @eventItem.RegistrationStart.ToString("yyyy. MM. dd. HH:mm")

                                            </div>

                                            <div>

                                                <i class="bi bi-stop-circle me-1 text-danger"></i>

                                                @eventItem.RegistrationEnd.ToString("yyyy. MM. dd. HH:mm")

                                            </div>

                                        </div>

                                    </td>

                                    <!-- ========================================= -->
                                    <!-- JELENTKEZÉS ÁLLAPOTA                      -->
                                    <!-- ========================================= -->

                                    <td>

                                        @if (eventItem.IsRegistrationEnabled)
                                        {
                                            <span class="badge bg-success">

                                                <i class="bi bi-check-circle me-1"></i>
                                                Engedélyezve

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">

                                                <i class="bi bi-x-circle me-1"></i>
                                                Letiltva

                                            </span>
                                        }

                                    </td>

                                    <!-- ========================================= -->
                                    <!-- MŰVELETEK                                 -->
                                    <!-- ========================================= -->

                                    <td class="text-end pe-3">

                                        <div class="d-flex justify-content-end flex-wrap gap-2">

                                            <!-- ========================================= -->
                                            <!-- JELENTKEZÉS INDÍTÁSA / LEÁLLÍTÁSA          -->
                                            <!-- ========================================= -->

                                            <form method="post"
                                                  asp-page-handler="ToggleRegistration"
                                                  class="d-inline">

                                                <input type="hidden"
                                                       name="eventId"
                                                       value="@eventItem.EventId" />

                                                <input type="hidden"
                                                       name="isEnabled"
                                                       value="@(!eventItem.IsRegistrationEnabled ? "true" : "false")" />

                                                @if (eventItem.IsRegistrationEnabled)
                                                {
                                                    <button type="submit"
                                                            class="btn btn-outline-warning btn-sm">

                                                        <i class="bi bi-pause-circle me-1"></i>
                                                        Jelentkezés leállítása

                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="submit"
                                                            class="btn btn-outline-success btn-sm">

                                                        <i class="bi bi-play-circle me-1"></i>
                                                        Jelentkezés indítása

                                                    </button>
                                                }

                                            </form>

                                            <!-- ========================================= -->
                                            <!-- ESEMÉNY SZERKESZTÉSE                      -->
                                            <!-- ========================================= -->

                                            <a asp-page="/Admin/Events/Edit"
                                               asp-route-id="@eventItem.EventId"
                                               class="btn btn-outline-primary btn-sm">

                                                <i class="bi bi-gear me-1"></i>
                                                Szerkesztés

                                            </a>

                                            <!-- ========================================= -->
                                            <!-- ÁTNEVEZÉS                                 -->
                                            <!-- ========================================= -->

                                            <button type="button"
                                                    class="btn btn-outline-primary btn-sm"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#renameModal-@eventItem.EventId">

                                                <i class="bi bi-pencil-square me-1"></i>
                                                Átnevezés

                                            </button>

                                            <!-- ========================================= -->
                                            <!-- TÖRLÉS                                    -->
                                            <!-- ========================================= -->

                                            <button type="button"
                                                    class="btn btn-outline-danger btn-sm"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#deleteModal-@eventItem.EventId">

                                                <i class="bi bi-trash me-1"></i>
                                                Törlés

                                            </button>

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

    <!-- ========================================= -->
    <!-- ÁTNEVEZÉSI ÉS TÖRLÉSI MODALOK             -->
    <!-- ========================================= -->
    @foreach (var eventItem in Model.Events)
    {
        <!-- ========================================= -->
        <!-- ÁTNEVEZÉSI MODAL                          -->
        <!-- ========================================= -->

        <div class="modal fade"
             id="renameModal-@eventItem.EventId"
             tabindex="-1"
             aria-labelledby="renameModalLabel-@eventItem.EventId"
             aria-hidden="true">

            <div class="modal-dialog modal-dialog-centered">

                <div class="modal-content">

                    <form method="post"
                          asp-page-handler="Rename">

                        <div class="modal-header">

                            <h5 class="modal-title"
                                id="renameModalLabel-@eventItem.EventId">

                                <i class="bi bi-pencil-square me-2"></i>
                                Esemény átnevezése

                            </h5>

                            <button type="button"
                                    class="btn-close"
                                    data-bs-dismiss="modal"
                                    aria-label="Bezárás">
                            </button>

                        </div>

                        <div class="modal-body">

                            <input type="hidden"
                                   name="EventId"
                                   value="@eventItem.EventId" />

                            <div class="mb-3">

                                <label class="form-label fw-semibold"
                                       for="newEventName-@eventItem.EventId">

                                    Esemény neve

                                </label>

                                <input type="text"
                                       class="form-control"
                                       id="newEventName-@eventItem.EventId"
                                       name="NewEventName"
                                       value="@eventItem.EventName"
                                       maxlength="200"
                                       required />

                            </div>

                            <div class="alert alert-info mb-0">

                                <i class="bi bi-info-circle me-1"></i>

                                Az átnevezés nem módosítja az esemény
                                dátumát, idősávjait vagy a jelentkezéseket.

                            </div>

                        </div>

                        <div class="modal-footer">

                            <button type="button"
                                    class="btn btn-secondary"
                                    data-bs-dismiss="modal">

                                Mégse

                            </button>

                            <button type="submit"
                                    class="btn btn-primary">

                                <i class="bi bi-check-lg me-1"></i>
                                Módosítás mentése

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

        <!-- ========================================= -->
        <!-- TÖRLÉSI MODAL                             -->
        <!-- ========================================= -->

        <div class="modal fade"
             id="deleteModal-@eventItem.EventId"
             tabindex="-1"
             aria-labelledby="deleteModalLabel-@eventItem.EventId"
             aria-hidden="true">

            <div class="modal-dialog modal-dialog-centered">

                <div class="modal-content">

                    <form method="post"
                          asp-page-handler="Delete">

                        <div class="modal-header">

                            <h5 class="modal-title text-danger"
                                id="deleteModalLabel-@eventItem.EventId">

                                <i class="bi bi-exclamation-triangle me-2"></i>
                                Esemény törlése

                            </h5>

                            <button type="button"
                                    class="btn-close"
                                    data-bs-dismiss="modal"
                                    aria-label="Bezárás">
                            </button>

                        </div>

                        <div class="modal-body">

                            <input type="hidden"
                                   name="eventId"
                                   value="@eventItem.EventId" />

                            <p>
                                Biztosan törölni szeretnéd a következő eseményt?
                            </p>

                            <div class="alert alert-light border">

                                <strong>
                                    @eventItem.EventName
                                </strong>

                                <div class="small text-muted mt-1">
                                    @eventItem.EventDate.ToString("yyyy. MM. dd.")
                                </div>

                            </div>

                            <div class="alert alert-danger mb-0">

                                <div class="fw-bold mb-2">

                                    <i class="bi bi-exclamation-triangle-fill me-1"></i>
                                    Figyelem! A törlés végleges!

                                </div>

                                <p class="mb-2">
                                    Az eseménnyel együtt törlődnek:
                                </p>

                                <ul class="mb-2">

                                    <li>Az esemény idősávjai</li>
                                    <li>Az eseményhez tartozó programalkalmak</li>
                                    <li>A diákok jelentkezései</li>
                                    <li>A tanári felügyeleti jelentkezések</li>
                                    <li>A felügyeleti helyek</li>

                                </ul>

                                <strong>
                                    A törölt adatok nem állíthatók vissza
                                    az alkalmazásból.
                                </strong>

                            </div>

                        </div>

                        <div class="modal-footer">

                            <button type="button"
                                    class="btn btn-secondary"
                                    data-bs-dismiss="modal">

                                Mégse

                            </button>

                            <button type="submit"
                                    class="btn btn-danger">

                                <i class="bi bi-trash me-1"></i>
                                Esemény végleges törlése

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>
    }

</div>