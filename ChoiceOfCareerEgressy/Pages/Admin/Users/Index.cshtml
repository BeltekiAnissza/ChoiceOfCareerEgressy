@page
@model ChoiceOfCareerEgressy.Pages.Admin.Users.IndexModel
@{
}
<h2>Felhasználók</h2>
<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Azonosító</th>
                <th>Név</th>
                <th>Email</th>
                <th>Szerepkör</th>
                <th>Osztály</th>
                <th>Ágazat</th>
                <th>Nem</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var user in Model.Users)
            {
                <tr>
                    <td>@user.UserId</td>
                    <td>@user.UserName</td>
                    <td>@user.EmailAddress</td>
                    <td>@user.Role</td>
                    <td>@user.GradeName</td>
                    <td>@user.BranchName</td>
                    <td>@user.SexName</td>
                </tr>
            }
        </tbody>
    </table>
</div>