@page
@using ChoiceOfCareerEgressy.Persistence
@model ChoiceOfCareerEgressy.Pages.Admin.Users.IndexModel

@{
    ViewData["Title"] = "Felhasználók kezelése";
}

<div class="container mt-4 mb-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Felhasználók kezelése</h2>

        <a asp-page="./Create" class="btn btn-success">
            + Új felhasználó
        </a>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="alert alert-success">
            @Model.SuccessMessage
        </div>
    }

    <!-- KERESÉS ÉS SZŰRÉS -->

    <div class="card shadow-sm mb-4">
        <div class="card-header">
            <strong>Keresés és rendezés</strong>
        </div>

        <div class="card-body">

            <form method="get">

                <div class="row g-3 align-items-end">

                    <!-- NÉV / E-MAIL KERESÉS -->

                    <div class="col-md-4">
                        <label asp-for="Search" class="form-label">
                            Keresés
                        </label>

                        <input asp-for="Search"
                               class="form-control"
                               placeholder="Név vagy e-mail-cím..." />
                    </div>

                    <!-- SZEREPKÖR -->

                    <div class="col-md-2">
                        <label asp-for="Role" class="form-label">
                            Szerepkör
                        </label>

                        <select asp-for="Role" class="form-select">
                            <option value="">Összes szerepkör</option>
                            <option value="@RoleChoice.Student">Diák</option>
                            <option value="@RoleChoice.Teacher">Tanár</option>
                            <option value="@RoleChoice.Admin">Admin</option>
                        </select>
                    </div>

                    <!-- OSZTÁLY -->

                    <div class="col-md-3">
                        <label asp-for="GradeId" class="form-label">
                            Osztály
                        </label>

                        <select asp-for="GradeId" class="form-select">
                            <option value="">Összes osztály</option>

                            @foreach (var grade in Model.Options.Grades)
                            {
                                <option value="@grade.Id">
                                    @grade.Name
                                </option>
                            }
                        </select>
                    </div>

                    <!-- RENDEZÉS -->

                    <div class="col-md-3">
                        <label asp-for="Sort" class="form-label">
                            Rendezés
                        </label>

                        <select asp-for="Sort" class="form-select">
                            <option value="">Név szerint (A–Z)</option>
                            <option value="name_desc">Név szerint (Z–A)</option>
                            <option value="grade_asc">Osztály szerint (A–Z)</option>
                            <option value="grade_desc">Osztály szerint (Z–A)</option>
                        </select>
                    </div>

                </div>

                <div class="d-flex gap-2 mt-3">

                    <button type="submit" class="btn btn-primary">
                        Keresés
                    </button>

                    <a asp-page="./Index"
                       class="btn btn-outline-secondary">
                        Szűrők törlése
                    </a>

                </div>

            </form>

        </div>
    </div>

    <!-- TALÁLATOK -->

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="mb-0">Felhasználók</h5>

        <span class="badge bg-secondary">
            @Model.Users.Count találat
        </span>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-striped table-hover mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>Név</th>
                            <th>E-mail-cím</th>
                            <th>Szerepkör</th>
                            <th>Osztály</th>
                            <th>Ágazat</th>
                            <th>Nem</th>
                            <th>Műveletek</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var user in Model.Users)
                        {
                            <tr>
                                <td>@user.UserName</td>
                                <td>@user.EmailAddress</td>

                                <td>
                                    @switch (user.Role)
                                    {
                                        case "Student":
                                            <span class="badge bg-primary">Diák</span>
                                            break;

                                        case "Teacher":
                                            <span class="badge bg-success">Tanár</span>
                                            break;

                                        case "Admin":
                                            <span class="badge bg-danger">Admin</span>
                                            break;

                                        default:
                                            @user.Role
                                            break;
                                    }
                                </td>

                                <td>@(user.GradeName ?? "–")</td>
                                <td>@(user.BranchName ?? "–")</td>
                                <td>@(user.SexName ?? "–")</td>

                                <td>
                                    <div class="d-flex gap-2">

                                        <a asp-page="./Edit"
                                           asp-route-id="@user.UserId"
                                           class="btn btn-sm btn-outline-primary">
                                            Módosítás
                                        </a>

                                        <a asp-page="./Delete"
                                           asp-route-id="@user.UserId"
                                           class="btn btn-sm btn-outline-danger">
                                            Törlés
                                        </a>

                                    </div>
                                </td>
                            </tr>
                        }

                        @if (!Model.Users.Any())
                        {
                            <tr>
                                <td colspan="7"
                                    class="text-center text-muted py-4">
                                    Nem található a keresési feltételeknek
                                    megfelelő felhasználó.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    </div>

</div>
