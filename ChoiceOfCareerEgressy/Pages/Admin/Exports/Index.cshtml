@page
@model ChoiceOfCareerEgressy.Pages.Admin.Exports.IndexModel

@using System.Text.Json

@{
    ViewData["Title"] = "Excel exportok";

    var plansJson = JsonSerializer.Serialize(
        Model.TimeSlots.Select(t => new
        {
            eventId = t.EventId,
            planId = t.PlanId,
            timeSlotId = t.Id,
            name = t.Name,
            number = t.Number
        }));
}

<h1>Excel exportok</h1>

<p>
    Az exportálás mindig egy kiválasztott esemény
    adatait tartalmazza.
</p>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">
        @Model.ErrorMessage
    </div>
}

<div class="row g-3">

    <!-- ========================================= -->
    <!-- OSZTÁLY EXPORT                           -->
    <!-- ========================================= -->

    <div class="col-12 col-lg-6">

        <section class="card p-3 h-100">

            <h2 class="h5">Osztály jelentkezései</h2>

            <form method="get"
                  asp-page="/Admin/Exports/Index"
                  class="d-grid gap-3">

                <input type="hidden"
                       name="handler"
                       value="Grade" />

                <div>
                    <label class="form-label" for="gradeEventId">
                        Esemény
                    </label>

                    <select id="gradeEventId"
                            name="eventId"
                            class="form-select"
                            required>

                        <option value="">
                            Válassz eseményt
                        </option>

                        @foreach (var ev in Model.Events)
                        {
                            <option value="@ev.Id">
                                @ev.Name
                            </option>
                        }

                    </select>
                </div>

                <div>
                    <label class="form-label" for="gradeId">
                        Osztály
                    </label>

                    <select id="gradeId"
                            name="gradeId"
                            class="form-select"
                            required>

                        <option value="">
                            Válassz osztályt
                        </option>

                        @foreach (var grade in Model.Grades)
                        {
                            <option value="@grade.Id">
                                @grade.Name
                            </option>
                        }

                    </select>
                </div>

                <button type="submit"
                        class="btn btn-primary">

                    <i class="bi bi-file-earmark-excel me-1"></i>

                    Osztály Excel letöltése

                </button>

            </form>

        </section>

    </div>

    <!-- ========================================= -->
    <!-- PROGRAM EXPORT                           -->
    <!-- ========================================= -->

    <div class="col-12 col-lg-6">

        <section class="card p-3 h-100">

            <h2 class="h5">Program jelentkezői</h2>

            <form method="get"
                  asp-page="/Admin/Exports/Index"
                  class="d-grid gap-3">

                <input type="hidden"
                       name="handler"
                       value="Plan" />

                <div>
                    <label class="form-label" for="planEventId">
                        Esemény
                    </label>

                    <select id="planEventId"
                            name="eventId"
                            class="form-select"
                            required>

                        <option value="">
                            Válassz eseményt
                        </option>

                        @foreach (var ev in Model.Events)
                        {
                            <option value="@ev.Id">
                                @ev.Name
                            </option>
                        }

                    </select>
                </div>

                <div>
                    <label class="form-label" for="planId">
                        Program
                    </label>

                    <select id="planId"
                            name="planId"
                            class="form-select"
                            required
                            disabled>

                        <option value="">
                            Először válassz eseményt
                        </option>

                        @foreach (var plan in Model.Plans)
                        {
                            <option value="@plan.Id">
                                @plan.Name
                            </option>
                        }

                    </select>
                </div>

                <div>
                    <label class="form-label" for="timeSlotId">
                        Idősáv
                    </label>

                    <select id="timeSlotId"
                            name="timeSlotId"
                            class="form-select"
                            required
                            disabled>

                        <option value="">
                            Először válassz programot
                        </option>

                    </select>
                </div>

                <button type="submit"
                        class="btn btn-primary">

                    <i class="bi bi-file-earmark-excel me-1"></i>

                    Program Excel letöltése

                </button>

            </form>

        </section>

    </div>

</div>

<!-- ========================================= -->
<!-- PROGRAMOK ÉS IDŐSÁVOK ADATAI             -->
<!-- ========================================= -->

<script id="exportSessionsData" type="application/json">
    @Html.Raw(plansJson.Replace("<", "\\u003C"))
</script>

@section Scripts
{
    <script src="~/js/admin/exports/index.js"
            asp-append-version="true"></script>
}