@page
@model ChoiceOfCareerEgressy.Pages.Admin.Registrations.Teachers.IndexModel

@{
    ViewData["Title"] = "Tanári felügyeletek kezelése";

    var eventId = Model.Data.EventId;
    var planSessionId = Model.Data.SelectedProgram?.PlanSessionId;
}

<div class="container mt-4">

    <h2>Tanári felügyeletek kezelése</h2>

    <p class="text-muted">
        A tanárok felügyeleti jelentkezéseinek áttekintése,
        módosítása és törlése.
    </p>

    <!-- ========================================= -->
    <!-- VISSZAJELZÉSEK                            -->
    <!-- ========================================= -->

    <div id="supervisionMessage">

        @if (TempData["Success"] is string success)
        {
            <div class="alert alert-success">
                @success
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger">
                @Model.ErrorMessage
            </div>
        }

    </div>

    @if (!Model.Data.Events.Any())
    {
        <div class="alert alert-info">
            Még nincs létrehozott esemény.
        </div>
    }
    else
    {
        <!-- ========================================= -->
        <!-- ESEMÉNY KIVÁLASZTÁSA                     -->
        <!-- ========================================= -->

        <form method="get" class="mb-4">

            <label class="form-label">Esemény</label>

            <input type="hidden"
                   name="viewMode"
                   value="@Model.ViewMode" />

            <select name="eventId"
                    class="form-select"
                    data-auto-submit="true">

                @foreach (var ev in Model.Data.Events)
                {
                    <option value="@ev.EventId"
                            selected="@(ev.EventId == eventId)">

                        @ev.EventName
                        (@ev.EventDate.ToString("yyyy.MM.dd."))

                    </option>
                }

            </select>

        </form>

        <!-- ========================================= -->
        <!-- NÉZET KIVÁLASZTÁSA                       -->
        <!-- ========================================= -->

        <ul class="nav nav-tabs mb-4">

            <li class="nav-item">

                <a class="nav-link @(Model.ViewMode == "teachers" ? "active" : "")"
                   asp-page="./Index"
                   asp-route-eventId="@eventId"
                   asp-route-viewMode="teachers">

                    Tanárok szerint

                </a>

            </li>

            <li class="nav-item">

                <a class="nav-link @(Model.ViewMode == "programs" ? "active" : "")"
                   asp-page="./Index"
                   asp-route-eventId="@eventId"
                   asp-route-viewMode="programs">

                    Programok szerint

                </a>

            </li>

        </ul>

        <!-- ========================================= -->
        <!-- TANÁROK SZERINTI NÉZET                   -->
        <!-- ========================================= -->
        @if (Model.ViewMode == "teachers")
        {
            <div class="card shadow-sm">

                <div class="card-header d-flex justify-content-between">

                    <strong>Tanárok</strong>

                    <span>
                        @Model.Data.Teachers.Count fő
                    </span>

                </div>

                <div class="card-body">

                    <div class="accordion" id="teachersAccordion">

                        @foreach (var teacher in Model.Data.Teachers)
                        {
                            <!-- ========================================= -->
                            <!-- TANÁR KÁRTYÁJA                           -->
                            <!-- ========================================= -->

                            <div class="accordion-item"
                                 id="teacher-card-@teacher.UserId">

                                <h2 class="accordion-header">

                                    <button class="accordion-button collapsed"
                                            type="button"
                                            data-bs-toggle="collapse"
                                            data-bs-target="#teacher-@teacher.UserId"
                                            aria-expanded="false"
                                            aria-controls="teacher-@teacher.UserId">

                                        <span class="me-3">
                                            @teacher.UserName
                                        </span>

                                        <span class="badge @(teacher.SupervisionCount == teacher.TimeSlots.Count ? "bg-success" : "bg-warning text-dark")">
                                            @teacher.SupervisionCount / @teacher.TimeSlots.Count
                                        </span>

                                    </button>

                                </h2>

                                <!-- ========================================= -->
                                <!-- TANÁR FELÜGYELETEI                       -->
                                <!-- ========================================= -->

                                <div id="teacher-@teacher.UserId"
                                     class="accordion-collapse collapse"
                                     data-bs-parent="#teachersAccordion">

                                    <div class="accordion-body">

                                        <p class="text-muted">
                                            @teacher.EmailAddress
                                        </p>

                                        @foreach (var slot in teacher.TimeSlots)
                                        {
                                            <!-- ========================================= -->
                                            <!-- IDŐSÁV                                   -->
                                            <!-- ========================================= -->

                                            <div class="border rounded p-3 mb-3">

                                                <h5>@slot.TimeSlotName</h5>

                                                <!-- AKTUÁLIS FELÜGYELET -->
                                                @if (slot.SupervisionId != null)
                                                {
                                                    <div class="alert alert-success py-2">

                                                        <strong>
                                                            @slot.CurrentProgramName
                                                        </strong>

                                                        <div class="small">
                                                            @slot.CurrentLocationName
                                                        </div>

                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="alert alert-warning py-2">
                                                        Nincs felügyeleti jelentkezés.
                                                    </div>
                                                }

                                                <!-- ========================================= -->
                                                <!-- FELÜGYELET MENTÉSE                        -->
                                                <!-- ========================================= -->

                                                <form method="post"
                                                      asp-page-handler="Save"
                                                      asp-route-viewMode="teachers"
                                                      class="mb-2 supervision-ajax-form">

                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden"
                                                           name="Change.TeacherId"
                                                           value="@teacher.UserId" />

                                                    <input type="hidden"
                                                           name="Change.EventId"
                                                           value="@eventId" />

                                                    <input type="hidden"
                                                           name="Change.TimeSlotId"
                                                           value="@slot.TimeSlotId" />

                                                    <label class="form-label">
                                                        Program kiválasztása
                                                    </label>

                                                    <div class="registration-form-row">

                                                        <select name="Change.PlanSessionId"
                                                                class="form-select"
                                                                required>

                                                            <option value="">
                                                                Válassz programot!
                                                            </option>

                                                            @foreach (var program in slot.Programs)
                                                            {
                                                                <option value="@program.PlanSessionId"
                                                                        selected="@(program.PlanSessionId == slot.SelectedPlanSessionId)">

                                                                    @program.PlanName
                                                                    – @program.LocationName
                                                                    (szabad felügyelői hely:
                                                                    @program.AvailablePlaces)

                                                                </option>
                                                            }

                                                        </select>

                                                        <button type="submit"
                                                                class="btn btn-primary">
                                                            Mentés
                                                        </button>

                                                    </div>

                                                </form>

                                                <!-- ========================================= -->
                                                <!-- FELÜGYELET TÖRLÉSE                       -->
                                                <!-- ========================================= -->
                                                @if (slot.SupervisionId != null)
                                                {
                                                    <form method="post"
                                                          asp-page-handler="Delete"
                                                          asp-route-viewMode="teachers"
                                                          class="supervision-ajax-form supervision-delete-form">

                                                        @Html.AntiForgeryToken()

                                                        <input type="hidden"
                                                               name="teacherId"
                                                               value="@teacher.UserId" />

                                                        <input type="hidden"
                                                               name="supervisionId"
                                                               value="@slot.SupervisionId" />

                                                        <input type="hidden"
                                                               name="eventId"
                                                               value="@eventId" />

                                                        <button type="submit"
                                                                class="btn btn-outline-danger btn-sm">
                                                            Felügyelet törlése
                                                        </button>

                                                    </form>
                                                }

                                            </div>
                                        }

                                    </div>

                                </div>

                            </div>
                        }

                    </div>

                </div>

            </div>
        }
        else
        {
            <!-- ========================================= -->
            <!-- PROGRAMOK SZERINTI NÉZET                 -->
            <!-- ========================================= -->

            <h4>Program kiválasztása</h4>

            <form method="get" class="mb-4">

                <input type="hidden"
                       name="eventId"
                       value="@eventId" />

                <input type="hidden"
                       name="viewMode"
                       value="programs" />

                <select name="planSessionId"
                        class="form-select"
                        data-auto-submit="true">

                    <option value="">
                        Válassz programot!
                    </option>

                    @foreach (var program in Model.Data.Programs)
                    {
                        <option value="@program.PlanSessionId"
                                selected="@(program.PlanSessionId == planSessionId)">

                            @program.TimeSlotName –
                            @program.PlanName –
                            @program.LocationName
                            (@program.RegisteredSupervisors/@program.RequiredSupervisors)

                        </option>
                    }

                </select>

            </form>

            <!-- ========================================= -->
            <!-- PROGRAM FELÜGYELETEINEK AJAX-FRISSÍTÉSE -->
            <!-- ========================================= -->

            <div id="programSupervisions">

                @if (Model.Data.SelectedProgram is { } selectedProgram)
                {
                    <!-- ========================================= -->
                    <!-- KIVÁLASZTOTT PROGRAM ADATAI               -->
                    <!-- ========================================= -->

                    <div class="card shadow-sm mb-4">

                        <div class="card-header">

                            <h4 class="mb-0">
                                @selectedProgram.PlanName
                            </h4>

                        </div>

                        <div class="card-body">

                            <p>
                                <strong>Idősáv:</strong>
                                @selectedProgram.TimeSlotName
                            </p>

                            <p>
                                <strong>Helyszín:</strong>
                                @selectedProgram.LocationName
                            </p>

                            <p>
                                <strong>Felügyelők:</strong>

                                <span class="badge @(selectedProgram.Supervisors.Count >= selectedProgram.RequiredSupervisors ? "bg-success" : "bg-warning text-dark")">

                                    @selectedProgram.Supervisors.Count
                                    /
                                    @selectedProgram.RequiredSupervisors

                                </span>
                            </p>

                        </div>

                    </div>

                    <!-- ========================================= -->
                    <!-- PROGRAM FELÜGYELŐINEK LISTÁJA            -->
                    <!-- ========================================= -->

                    <div class="card shadow-sm">

                        <div class="card-header d-flex justify-content-between">

                            <strong>Beosztott tanárok</strong>

                            <span>
                                @selectedProgram.Supervisors.Count fő
                            </span>

                        </div>

                        <div class="card-body">

                            @if (!selectedProgram.Supervisors.Any())
                            {
                                <div class="alert alert-info">
                                    Ehhez a programhoz még nincs beosztott tanár.
                                </div>
                            }
                            else
                            {
                                <div class="table-responsive">

                                    <table class="table table-striped align-middle">

                                        <thead>
                                            <tr>
                                                <th>Tanár</th>
                                                <th>E-mail</th>
                                                <th>Másik program</th>
                                                <th>Törlés</th>
                                            </tr>
                                        </thead>

                                        <tbody>

                                            @foreach (var supervisor in selectedProgram.Supervisors)
                                            {
                                                <tr>

                                                    <td>
                                                        @supervisor.TeacherName
                                                    </td>

                                                    <td>
                                                        @supervisor.EmailAddress
                                                    </td>

                                                    <td>

                                                        <!-- FELÜGYELET MÓDOSÍTÁSA -->

                                                        <form method="post"
                                                              asp-page-handler="Save"
                                                              asp-route-planSessionId="@selectedProgram.PlanSessionId"
                                                              asp-route-viewMode="programs"
                                                              class="supervision-ajax-form">

                                                            @Html.AntiForgeryToken()

                                                            <input type="hidden"
                                                                   name="Change.TeacherId"
                                                                   value="@supervisor.TeacherId" />

                                                            <input type="hidden"
                                                                   name="Change.EventId"
                                                                   value="@eventId" />

                                                            <input type="hidden"
                                                                   name="Change.TimeSlotId"
                                                                   value="@selectedProgram.TimeSlotId" />

                                                            <div class="registration-form-row">

                                                                <select name="Change.PlanSessionId"
                                                                        class="form-select"
                                                                        required>

                                                                    @foreach (var program in supervisor.AvailablePrograms)
                                                                    {
                                                                        <option value="@program.PlanSessionId"
                                                                                selected="@(program.PlanSessionId == selectedProgram.PlanSessionId)">

                                                                            @program.PlanName
                                                                            – @program.LocationName
                                                                            (szabad: @program.AvailablePlaces)

                                                                        </option>
                                                                    }

                                                                </select>

                                                                <button type="submit"
                                                                        class="btn btn-primary btn-sm">
                                                                    Mentés
                                                                </button>

                                                            </div>

                                                        </form>

                                                    </td>

                                                    <td>

                                                        <!-- FELÜGYELET TÖRLÉSE -->

                                                        <form method="post"
                                                              asp-page-handler="Delete"
                                                              asp-route-planSessionId="@selectedProgram.PlanSessionId"
                                                              asp-route-viewMode="programs"
                                                              class="supervision-ajax-form supervision-delete-form">

                                                            @Html.AntiForgeryToken()

                                                            <input type="hidden"
                                                                   name="teacherId"
                                                                   value="@supervisor.TeacherId" />

                                                            <input type="hidden"
                                                                   name="supervisionId"
                                                                   value="@supervisor.SupervisionId" />

                                                            <input type="hidden"
                                                                   name="eventId"
                                                                   value="@eventId" />

                                                            <button type="submit"
                                                                    class="btn btn-outline-danger btn-sm">
                                                                Törlés
                                                            </button>

                                                        </form>

                                                    </td>

                                                </tr>
                                            }

                                        </tbody>

                                    </table>

                                </div>
                            }

                        </div>

                    </div>
                }

            </div>
        }
    }

</div>

@section Scripts
{
    <script src="~/js/admin/registrations/teacher_index.js"
            asp-append-version="true"></script>
}