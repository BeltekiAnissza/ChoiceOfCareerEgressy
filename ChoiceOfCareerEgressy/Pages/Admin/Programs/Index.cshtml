@page
@model ChoiceOfCareerEgressy.Pages.Admin.Programs.IndexModel

@{
    ViewData["Title"] = "Programok kezelése";

    var selectedEvent = Model.Events
        .FirstOrDefault(e => e.Id == Model.EventId);
}

<div class="container mt-4">

    <!-- ========================================= -->
    <!-- FEJLÉC                                    -->
    <!-- ========================================= -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2>Programok kezelése</h2>

            <p class="text-muted mb-0">
                Pályaorientációs programok létrehozása,
                módosítása és törlése.
            </p>
        </div>

        <a asp-page="./Create"
           class="btn btn-success">
            + Új program
        </a>

    </div>

    <!-- ========================================= -->
    <!-- VISSZAJELZÉSEK                            -->
    <!-- ========================================= -->
    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="alert alert-success">
            @Model.SuccessMessage
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger">
            @Model.ErrorMessage
        </div>
    }

    <!-- ========================================= -->
    <!-- ESEMÉNY KIVÁLASZTÁSA                      -->
    <!-- ========================================= -->

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <div class="row g-3 align-items-end">

                <div class="col-md-5">

                    <form method="get" id="eventForm">

                        <label asp-for="EventId"
                               class="form-label fw-bold">
                            Esemény kiválasztása
                        </label>

                        <select asp-for="EventId"
                                class="form-select"
                                onchange="document.getElementById('eventForm').submit()">

                            @foreach (var ev in Model.Events)
                            {
                                <option value="@ev.Id">
                                    @ev.Name
                                </option>
                            }

                        </select>

                    </form>

                </div>

                <div class="col-md-7">

                    <form method="get"
                          class="row g-2 align-items-end">

                        <input type="hidden"
                               name="EventId"
                               value="@Model.EventId" />

                        <div class="col-md-8">

                            <label asp-for="Search"
                                   class="form-label">
                                Program keresése
                            </label>

                            <input asp-for="Search"
                                   class="form-control"
                                   placeholder="Név, leírás vagy terem..." />

                        </div>

                        <div class="col-md-4">

                            <button type="submit"
                                    class="btn btn-primary">
                                Keresés
                            </button>

                            <a asp-page="./Index"
                               asp-route-EventId="@Model.EventId"
                               class="btn btn-outline-secondary">
                                Törlés
                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

    <!-- ========================================= -->
    <!-- ÖSSZESÍTÉS                               -->
    <!-- ========================================= -->

    <div class="row g-3 mb-4">

        <div class="col-md-4">

            <div class="card shadow-sm">

                <div class="card-body">

                    <div class="text-muted">
                        Programalkalmak
                    </div>

                    <h3 class="mb-0">
                        @Model.Programs.Count
                    </h3>

                </div>

            </div>

        </div>

        <div class="col-md-4">

            <div class="card shadow-sm">

                <div class="card-body">

                    <div class="text-muted">
                        Aktív jelentkezések
                    </div>

                    <h3 class="mb-0">
                        @Model.Programs.Sum(p => p.ApplicationCount)
                    </h3>

                </div>

            </div>

        </div>

        <div class="col-md-4">

            <div class="card shadow-sm">

                <div class="card-body">

                    <div class="text-muted">
                        Szabad férőhelyek
                    </div>

                    <h3 class="mb-0">
                        @Model.Programs.Sum(p => p.AvailablePlaces)
                    </h3>

                </div>

            </div>

        </div>

    </div>

    <!-- ========================================= -->
    <!-- PROGRAMOK FEJLÉCE                       -->
    <!-- ========================================= -->

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">

        <div>

            <h4 class="mb-1">
                Programok listája
            </h4>

            @if (selectedEvent != null)
            {
                <div class="text-muted small">
                    Kiválasztott esemény:
                    <strong>@selectedEvent.Name</strong>
                </div>
            }

        </div>

        @if (selectedEvent != null && Model.Programs.Any())
        {
            <button type="button"
                    class="btn btn-danger"
                    data-bs-toggle="modal"
                    data-bs-target="#deleteAllProgramsModal">

                <i class="bi bi-trash me-1"></i>
                Minden program törlése

            </button>
        }
        else
        {
            <button type="button"
                    class="btn btn-outline-danger"
                    disabled>

                <i class="bi bi-trash me-1"></i>
                Minden program törlése

            </button>
        }

    </div>

    <!-- ========================================= -->
    <!-- PROGRAMOK TÁBLÁZATA                      -->
    <!-- ========================================= -->

    <div class="card shadow-sm">

        <div class="card-body">

            @if (!Model.Events.Any())
            {
                <div class="alert alert-warning mb-0">
                    Még nincs létrehozott esemény.
                </div>
            }
            else if (!Model.Programs.Any())
            {
                <div class="alert alert-info mb-0">
                    Nincs a keresési feltételeknek megfelelő program.
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-striped table-hover align-middle">

                        <thead class="table-dark">

                            <tr>
                                <th>Program</th>
                                <th>Esemény</th>
                                <th>Időpont</th>
                                <th>Terem</th>
                                <th>Jogosultság</th>
                                <th>Kapacitás</th>
                                <th>Jelentkezők</th>
                                <th>Felügyelők</th>
                                <th class="text-end">Műveletek</th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var program in Model.Programs)
                            {
                                <tr>

                                    <td>

                                        <strong>
                                            @program.PlanName
                                        </strong>

                                        <div class="small text-muted">
                                            @program.PlanDescription
                                        </div>

                                    </td>

                                    <td>
                                        @program.EventName
                                    </td>

                                    <td>

                                        <div>
                                            @program.BeginDate.ToString("yyyy.MM.dd.")
                                        </div>

                                        <div class="small text-muted">
                                            @program.BeginDate.ToString("HH:mm")
                                            –
                                            @program.EndDate.ToString("HH:mm")
                                        </div>

                                        <div class="small">
                                            @program.TimeSlotName
                                        </div>

                                    </td>

                                    <td>
                                        @program.LocationName
                                    </td>

                                    <td>

                                        <div class="small">
                                            @program.SexName
                                        </div>

                                        <div class="small text-muted">
                                            @program.BranchName
                                        </div>

                                    </td>

                                    <td>

                                        <span class="badge bg-secondary">
                                            @program.Capacity fő
                                        </span>

                                    </td>

                                    <td>

                                        @program.ApplicationCount

                                        @if (program.AvailablePlaces == 0)
                                        {
                                            <span class="badge bg-danger ms-1">
                                                Betelt
                                            </span>
                                        }
                                        else
                                        {
                                            <div class="small text-success">
                                                @program.AvailablePlaces szabad
                                            </div>
                                        }

                                    </td>

                                    <td>
                                        @program.SupervisionCount /
                                        @program.RequiredSupervisors
                                    </td>

                                    <td class="text-end">

                                        <div class="d-flex gap-2 justify-content-end">

                                            <a asp-page="./Edit"
                                               asp-route-id="@program.PlanSessionId"
                                               class="btn btn-sm btn-outline-primary">
                                                Módosítás
                                            </a>

                                            <a asp-page="./Delete"
                                               asp-route-id="@program.PlanSessionId"
                                               class="btn btn-sm btn-outline-danger">
                                                Törlés
                                            </a>

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

    <!-- ========================================= -->
    <!-- EXCEL IMPORTÁLÁS                         -->
    <!-- ========================================= -->

    <div class="mt-3">

        <a asp-page="./Import"
           class="btn btn-outline-secondary">
            Programok importálása Excelből
        </a>

    </div>

</div>

<!-- ========================================= -->
<!-- ÖSSZES PROGRAM TÖRLÉSÉNEK MEGERŐSÍTÉSE    -->
<!-- ========================================= -->
@if (selectedEvent != null)
{
    <div class="modal fade"
         id="deleteAllProgramsModal"
         tabindex="-1"
         aria-labelledby="deleteAllProgramsModalLabel"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content">

                <div class="modal-header bg-danger text-white">

                    <h5 class="modal-title"
                        id="deleteAllProgramsModalLabel">

                        <i class="bi bi-exclamation-triangle me-2"></i>
                        Minden program törlése

                    </h5>

                    <button type="button"
                            class="btn-close btn-close-white"
                            data-bs-dismiss="modal"
                            aria-label="Bezárás">
                    </button>

                </div>

                <div class="modal-body">

                    <p>
                        Biztosan törölni szeretnéd a következő esemény
                        <strong>összes programját</strong>?
                    </p>

                    <div class="alert alert-secondary">

                        <strong>
                            @selectedEvent.Name
                        </strong>

                    </div>

                    <div class="alert alert-danger">

                        <strong>
                            Figyelem! A művelet nem vonható vissza.
                        </strong>

                        <p class="mt-2 mb-0">
                            Az esemény összes programalkalma törlődik,
                            beleértve a kapcsolódó diákjelentkezéseket
                            és tanári felügyeleteket is.
                        </p>

                    </div>

                    <p class="small text-muted mb-0">
                        Más események programjai megmaradnak.
                    </p>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Mégse
                    </button>

                    <form method="post"
                          asp-page-handler="DeleteAll">

                        <input type="hidden"
                               name="eventId"
                               value="@selectedEvent.Id" />

                        <button type="submit"
                                class="btn btn-danger">
                            Összes program végleges törlése
                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>
}