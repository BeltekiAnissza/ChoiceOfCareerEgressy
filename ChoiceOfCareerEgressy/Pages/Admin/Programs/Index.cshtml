@page
@model ChoiceOfCareerEgressy.Pages.Admin.Programs.IndexModel

@{
    ViewData["Title"] = "Programok kezelése";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Programok kezelése</h2>
            <p class="text-muted mb-0">
                Pályaorientációs programok létrehozása,
                módosítása és törlése.
            </p>
        </div>

        <a asp-page="./Create"
           class="btn btn-success">
            + Új program
        </a>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="alert alert-success">
            @Model.SuccessMessage
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger">
            @Model.ErrorMessage
        </div>
    }

    <!-- KERESÉS ÉS SZŰRÉS -->

    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <form method="get" class="row g-3 align-items-end">

                <div class="col-md-5">
                    <label asp-for="Search"
                           class="form-label">
                        Program keresése
                    </label>

                    <input asp-for="Search"
                           class="form-control"
                           placeholder="Program neve, leírása vagy terem..." />
                </div>

                <div class="col-md-4">
                    <label asp-for="EventId"
                           class="form-label">
                        Esemény
                    </label>

                    <select asp-for="EventId"
                            class="form-select">

                        <option value="">Összes esemény</option>

                        @foreach (var ev in Model.Events)
                        {
                            <option value="@ev.Id">
                                @ev.Name
                            </option>
                        }

                    </select>
                </div>

                <div class="col-md-3">
                    <button type="submit"
                            class="btn btn-primary">
                        Keresés
                    </button>

                    <a asp-page="./Index"
                       class="btn btn-outline-secondary">
                        Alaphelyzet
                    </a>
                </div>

            </form>
        </div>
    </div>

    <!-- ÖSSZESÍTÉS -->

    <div class="row g-3 mb-4">

        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="text-muted">Programalkalmak</div>
                    <h3 class="mb-0">@Model.Programs.Count</h3>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="text-muted">Aktív jelentkezések</div>
                    <h3 class="mb-0">
                        @Model.Programs.Sum(p => p.ApplicationCount)
                    </h3>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="text-muted">Szabad férőhelyek</div>
                    <h3 class="mb-0">
                        @Model.Programs.Sum(p => p.AvailablePlaces)
                    </h3>
                </div>
            </div>
        </div>

    </div>

    <!-- PROGRAMOK TÁBLÁZATA -->

    <div class="card shadow-sm">
        <div class="card-body">

            @if (!Model.Programs.Any())
            {
                <div class="alert alert-info mb-0">
                    Nincs a keresési feltételeknek megfelelő program.
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-striped table-hover align-middle">

                        <thead class="table-dark">
                            <tr>
                                <th>Program</th>
                                <th>Esemény</th>
                                <th>Időpont</th>
                                <th>Terem</th>
                                <th>Jogosultság</th>
                                <th>Kapacitás</th>
                                <th>Jelentkezők</th>
                                <th>Felügyelők</th>
                                <th class="text-end">Műveletek</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var program in Model.Programs)
                            {
                                <tr>

                                    <td>
                                        <strong>@program.PlanName</strong>

                                        <div class="small text-muted">
                                            @program.PlanDescription
                                        </div>
                                    </td>

                                    <td>
                                        @program.EventName
                                    </td>

                                    <td>
                                        <div>
                                            @program.BeginDate.ToString("yyyy.MM.dd.")
                                        </div>

                                        <div class="small text-muted">
                                            @program.BeginDate.ToString("HH:mm")
                                            –
                                            @program.EndDate.ToString("HH:mm")
                                        </div>

                                        <div class="small">
                                            @program.TimeSlotName
                                        </div>
                                    </td>

                                    <td>
                                        @program.LocationName
                                    </td>

                                    <td>
                                        <div class="small">
                                            @program.SexName
                                        </div>

                                        <div class="small text-muted">
                                            @program.BranchName
                                        </div>
                                    </td>

                                    <td>
                                        <span class="badge bg-secondary">
                                            @program.Capacity fő
                                        </span>
                                    </td>

                                    <td>
                                        @program.ApplicationCount

                                        @if (program.AvailablePlaces == 0)
                                        {
                                            <span class="badge bg-danger ms-1">
                                                Betelt
                                            </span>
                                        }
                                        else
                                        {
                                            <div class="small text-success">
                                                @program.AvailablePlaces szabad
                                            </div>
                                        }
                                    </td>

                                    <td>
                                        @program.SupervisionCount /
                                        @program.RequiredSupervisors
                                    </td>

                                    <td class="text-end">
                                        <div class="d-flex gap-2 justify-content-end">

                                            <a asp-page="./Edit"
                                               asp-route-id="@program.PlanSessionId"
                                               class="btn btn-sm btn-outline-primary">
                                                Módosítás
                                            </a>

                                            <a asp-page="./Delete"
                                               asp-route-id="@program.PlanSessionId"
                                               class="btn btn-sm btn-outline-danger">
                                                Törlés
                                            </a>

                                        </div>
                                    </td>

                                </tr>
                            }

                        </tbody>
                    </table>

                </div>
            }

        </div>
    </div>

    <div class="mt-3">
        <a asp-page="./Import"
           class="btn btn-outline-secondary">
            Programok importálása Excelből
        </a>
    </div>

</div>
