@page
@model ChoiceOfCareerEgressy.Pages.Account.LoginModel

@{
    ViewData["Title"] = "Bejelentkezés";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">

            <div class="card shadow">
                <div class="card-body p-4">

                    <h3 class="text-center mb-4">
                        Pályaorientációs nap
                    </h3>

                    <h5 class="text-center mb-4">
                        Bejelentkezés
                    </h5>

                    <form method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-3">
                            <label asp-for="Login.EmailAddress"
                                   class="form-label">
                                Email-cím
                            </label>

                            <input asp-for="Login.EmailAddress"
                                   class="form-control"
                                   type="email"
                                   autocomplete="username" />

                            <span asp-validation-for="Login.EmailAddress"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Login.Password"
                                   class="form-label">
                                Jelszó
                            </label>

                            <input asp-for="Login.Password"
                                   class="form-control"
                                   type="password"
                                   autocomplete="current-password" />

                            <span asp-validation-for="Login.Password"
                                  class="text-danger">
                            </span>
                        </div>

                        <button type="submit"
                                class="btn btn-primary w-100">
                            Bejelentkezés
                        </button>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
