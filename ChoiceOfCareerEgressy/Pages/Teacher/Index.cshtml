@page
@model ChoiceOfCareerEgressy.Pages.Teacher.IndexModel
@{
    ViewData["Title"] = "Tanári felügyeletek";
}

<div class="container mt-4">

    <h2>Tanári felügyeleti jelentkezés</h2>

    <p class="text-muted">
        Válassz programot, amelyen felügyelőtanárként
        szeretnél részt venni!
        Egy idősávban egy felügyeletet vállalhatsz.
    </p>

    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="alert alert-success">
            @Model.SuccessMessage
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger">
            @Model.ErrorMessage
        </div>
    }

    @if (!Model.Events.Any())
    {
        <div class="alert alert-info">
            Jelenleg nincs elérhető esemény.
        </div>
    }

    @foreach (var ev in Model.Events)
    {
        <div class="card shadow-sm mb-4">

            <div class="card-header">
                <h4 class="mb-0">@ev.EventName</h4>
                <small>
                    @ev.EventDate.ToString("yyyy.MM.dd.")
                </small>
            </div>

            <div class="card-body">

                @foreach (var slot in ev.TimeSlots)
                {
                    bool hasMySupervision = slot.Programs
                    .Any(p => p.IsMySupervision);

                    <h5 class="mt-3">
                        @slot.TimeSlotName
                        (@slot.BeginDate.ToString("HH:mm")
                        –
                        @slot.EndDate.ToString("HH:mm"))
                    </h5>

                    @if (!slot.Programs.Any())
                    {
                        <p class="text-muted">
                            Ebben az idősávban még nincs program.
                        </p>
                    }

                    <div class="table-responsive">
                        <table class="table table-striped align-middle">
                            <thead>
                                <tr>
                                    <th>Program</th>
                                    <th>Terem</th>
                                    <th>Felügyelők</th>
                                    <th>Jelentkezés</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var program in slot.Programs)
                                {
                                    <tr>
                                        <td>@program.PlanName</td>
                                        <td>@program.LocationName</td>
                                        <td>
                                            @program.RegisteredSupervisors
                                            /
                                            @program.RequiredSupervisors
                                        </td>

                                        <td>
                                            @if (program.IsMySupervision)
                                            {
                                                <span class="badge bg-success">
                                                    Jelentkezve
                                                </span>

                                                <form method="post"
                                                      asp-page-handler="Cancel"
                                                      class="mt-2">

                                                    <input type="hidden"
                                                           name="planSessionId"
                                                           value="@program.PlanSessionId" />

                                                    <button type="submit"
                                                            class="btn btn-outline-danger btn-sm"
                                                            disabled="@(slot.BeginDate <= DateTimeOffset.UtcNow)">
                                                        Lemondás
                                                    </button>
                                                </form>
                                            }
                                            else if (program.AvailablePlaces == 0)
                                            {
                                                <span class="badge bg-secondary">
                                                    Betelt
                                                </span>
                                            }
                                            else if (hasMySupervision)
                                            {
                                                <span class="text-muted">
                                                    Másik felügyeletet vállaltál
                                                </span>
                                            }
                                            else if (slot.BeginDate <= DateTimeOffset.UtcNow)
                                            {
                                                <span class="text-muted">
                                                    A jelentkezés lezárult
                                                </span>
                                            }
                                            else
                                            {
                                                <form method="post"
                                                      asp-page-handler="Register">

                                                    <input type="hidden"
                                                           name="planSessionId"
                                                           value="@program.PlanSessionId" />

                                                    <button type="submit"
                                                            class="btn btn-primary btn-sm">
                                                        Jelentkezem
                                                    </button>
                                                </form>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

            </div>
        </div>
    }

</div>