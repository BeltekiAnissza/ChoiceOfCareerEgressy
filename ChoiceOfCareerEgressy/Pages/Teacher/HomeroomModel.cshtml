@page
@model ChoiceOfCareerEgressy.Pages.Teacher.HomeroomModel

@{
    ViewData["Title"] = "Osztályom jelentkezései";
}

<div class="container mt-4">

    <h2>Osztályom jelentkezései</h2>

    <p class="text-muted">
        Itt ellenőrizheted és módosíthatod
        a saját osztályod diákjainak jelentkezéseit.
    </p>

@if (TempData["Success"] is string success)
{
        <div class="alert alert-success">@success</div>
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
        <div class="alert alert-danger">
            @Model.ErrorMessage
        </div>
}

@if (Model.Data.Events.Any())
{
        <form method="get" class="mb-4">
            <label class="form-label">Esemény</label>

            <select name="eventId"
                    class="form-select"
                    onchange="this.form.submit()">

                @foreach (var ev in Model.Data.Events)
                {
                    <option value="@ev.EventId"
                            selected="@(ev.EventId == Model.Data.EventId)">
                        @ev.EventName
                        (@ev.EventDate.ToString("yyyy.MM.dd."))
                    </option>
                }
            </select>
        </form>
}
else
{
        <div class="alert alert-info">
            Még nincs létrehozott esemény.
        </div>
}

@if (!Model.Data.Grades.Any())
{
        <div class="alert alert-info">
            Jelenleg nincs hozzád rendelt osztály.
        </div>
}

@foreach (var grade in Model.Data.Grades)
{
        <div class="card mb-4 shadow-sm">

            <div class="card-header">
                <h4 class="mb-0">@grade.GradeName</h4>
                <small>
                    @grade.Students.Count diák
                </small>
            </div>

            <div class="card-body">

                <div class="accordion"
                     id="grade-@grade.GradeId">

                    @foreach (var student in grade.Students)
                    {
                        var count = student.RegistrationCount;
                        var complete = count == 2;

                        <div class="accordion-item">

                            <h2 class="accordion-header"
                                id="heading-@student.UserId">

                                <button class="accordion-button collapsed"
                                        type="button"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#student-@student.UserId"
                                        aria-expanded="false"
                                        aria-controls="student-@student.UserId">

                                    <span class="me-3">
                                        @student.UserName
                                    </span>

                                    <span class="badge @(complete ? "bg-success" : "bg-warning text-dark")">
                                        @count / 2 program
                                    </span>
                                </button>
                            </h2>

                            <div id="student-@student.UserId"
                                 class="accordion-collapse collapse"
                                 aria-labelledby="heading-@student.UserId"
                                 data-bs-parent="#grade-@grade.GradeId">

                                <div class="accordion-body">

                                    <p class="text-muted">
                                        @student.EmailAddress
                                    </p>

                                    @foreach (var slot in student.TimeSlots)
                                    {
                                        var current = student.Applications
                                        .FirstOrDefault(a =>
                                        a.ApplicationId ==
                                        slot.ApplicationId);

                                        <div class="border rounded p-3 mb-3">

                                            <h5>@slot.TimeSlotName</h5>

                                            @if (current != null)
                                            {
                                                <p>
                                                    <strong>
                                                        @current.PlanName
                                                    </strong>

                                                    <span class="text-muted">
                                                        – @current.LocationName
                                                    </span>
                                                </p>

                                                <p class="small text-muted">
                                                    @current.BeginDate.ToString("HH:mm")
                                                    –
                                                    @current.EndDate.ToString("HH:mm")
                                                </p>
                                            }
                                            else
                                            {
                                                <p class="text-warning">
                                                    Még nem jelentkezett.
                                                </p>
                                            }

                                            <form method="post"
                                                  asp-page-handler="Change"
                                                  class="mb-2">

                                                <input type="hidden"
                                                       name="Change.StudentId"
                                                       value="@student.UserId" />

                                                <input type="hidden"
                                                       name="Change.EventId"
                                                       value="@Model.Data.EventId" />

                                                <input type="hidden"
                                                       name="Change.TimeSlotId"
                                                       value="@slot.TimeSlotId" />

                                                <label class="form-label">
                                                    Program kiválasztása
                                                </label>

                                                <div class="registration-form-row">

                                                    <select name="Change.PlanSessionId"
                                                            class="form-select"
                                                            required>

                                                        <option value="">
                                                            Válassz programot!
                                                        </option>

                                                        @foreach (var program in slot.Programs)
                                                        {
                                                            <option value="@program.PlanSessionId"
                                                                    selected="@(program.PlanSessionId == slot.SelectedPlanSessionId)">
                                                                @program.PlanName
                                                                – @program.LocationName
                                                                (szabad: @program.AvailablePlaces)
                                                            </option>
                                                        }
                                                    </select>

                                                    <button class="btn btn-primary" type="submit">
                                                        Mentés
                                                    </button>

                                                </div>
                                            </form>

                                            @if (current != null)
                                            {
                                                <form method="post"
                                                      asp-page-handler="Delete"
                                                      onsubmit="return confirm('Biztosan törlöd a jelentkezést?')">

                                                    <input type="hidden"
                                                           name="studentId"
                                                           value="@student.UserId" />

                                                    <input type="hidden"
                                                           name="applicationId"
                                                           value="@current.ApplicationId" />

                                                    <input type="hidden"
                                                           name="eventId"
                                                           value="@Model.Data.EventId" />

                                                    <button type="submit"
                                                            class="btn btn-outline-danger btn-sm">
                                                        Jelentkezés törlése
                                                    </button>
                                                </form>
                                            }

                                        </div>
                                    }

                                </div>
                            </div>

                        </div>
                    }
                </div>
            </div>
        </div>
}
